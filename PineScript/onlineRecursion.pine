//@version=6

//@description
// XeL onlineRecursion
//
// A collection of online or streaming tools designed primarily around
// O(1) per-observation update equations for filtering, statistical
// analysis / estimation, and other operations on continuous data streams.
//
// The library provides:
//   • Streaming state types and functional streaming interfaces
//   • First-order IIR filtering and recursive extrema estimation
//   • Sample-and-hold, settlement, accumulation, and exact rolling sums
//   • Fixed-memory P² cumulative quantile estimation
//   • Recursive adaptive quantile, expectile, conditional tail-mean,
//     robust Huber-location, MAD-based scale, covariance, correlation,
//     and linear-regression estimation
//   • Recursive Heavy-Tail distribution estimation
//   • Relative-return, relative-projection, and additive-moment transforms
//   • Market-data population helpers
//   • Recursive coefficient constructors
//   • Market-participation models
//   • Market-dispersion models
//
// The design follows a stream-processing architecture:
// observations → streaming state → online statistics → derived evidence.
//
// Stateful streaming primitives are represented by user-defined types and,
// where useful, functional interfaces.
//
// Stateless mathematical transforms remain ordinary functions.
//
// Numerical-domain policy:
//
// Invalid model configuration or impossible structural relationships may
// generate runtime errors.
//
// Missing observations, unavailable market data, and dynamically undefined
// mathematical domains return na so fallback policy remains with the caller.
//

library(
    "onlineRecursion",
    overlay = false,
    dynamic_requests = true
)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INTERNAL NUMERICAL CONSTANTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// General floating-point floor used where a strictly positive quantity
// is mathematically required.
const float MIN_FLOAT = 1e-16

// Student-t moment constraints.
const float MIN_STUDENT_DF = 5.0
const float MAX_STUDENT_DF = 30.0

// sqrt(pi / 2), converting Gaussian mean absolute deviation
// into an equivalent sigma scale.
const float MEAN_ABS_TO_SIGMA = 1.2533141373155

// 1 / Phi^-1(0.75), converting raw median absolute deviation
// into the conventional Gaussian-equivalent robust scale.
const float MAD_TO_GAUSSIAN_SCALE = 1.482602218505602


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PUBLIC ENUMERATORS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━


//@enum Defines supported dimensionless relative-return transformations.
//@field arithmetic Arithmetic relative return: current / reference - 1
//@field logarithmic Natural-log relative return: ln(current / reference)
export enum ReturnModel
    arithmetic  = "Arithmetic Return"
    logarithmic = "Logarithmic Return"


//@enum Defines supported recursive-decay interpretations.
//@field bypass No recursive-decay contribution. Alpha = 0.
//@field reciprocal Reciprocal alpha: 1/N.
//@field exponential EMA-equivalent alpha: 2/(N+1).
//@field eFold E-folding horizon.
//@field halfLife Half-life horizon.
//@field decay25 25-percent decay horizon.
//@field decay75 75-percent decay horizon.
//@field decay95 95-percent decay horizon.
export enum DecayModel
    bypass      = "Bypass"
    reciprocal  = "Reciprocal 1/N"
    exponential = "Exponential 2/(N+1)"
    eFold       = "E-Folding"
    halfLife    = "Half-Life"
    decay25     = "25% Decay"
    decay75     = "75% Decay"
    decay95     = "95% Decay"


//@enum Defines the conditional tail selected by adaptive tail-mean estimators.
//
// Lower-tail membership:
//     input <= threshold
//
// Upper-tail membership:
//     input >= threshold
//
// Observations exactly equal to the threshold belong to either selected tail.
//
//@field lower Conditional lower tail.
//@field upper Conditional upper tail.
export enum TailSide
    lower = "Lower Tail"
    upper = "Upper Tail"


//@enum Defines market-participation alpha models.
// Participation-reference models.
//
// Models are organized by the domain used to normalize the current processing
// observation:
//
//     none
//         No participation contribution.
//
//     equal
//         Uniform participation with weight 1/N.
//
//     rollingVolume
//         Processing-domain participation using an exact rolling population of
//         N processing observations.
//
//     minuteVolume
//     hourlyVolume
//     dailyVolume
//     weeklyVolume
//     monthlyVolume
//         Explicit time-domain participation.
//
//         These members select the REFERENCE DOMAIN only. Population continuity
//         is selected independently by the `elapsedTime` argument of
//         participationAlpha():
//
//             false -> confirmed-observation continuity
//             true  -> elapsed/calendar continuity
//
//     openInterest
//     floatTurnover
//     fundTurnover
//         Fundamental-population participation using a reported or
//         reported-data-derived external reference population.
//
// Explicit time-domain models always use settled or confirmed reference
// populations. Developing reference-domain data is never used as the
// participation denominator.
//
//@field none No market-participation contribution. Alpha = 0.
//@field equal Uniform participation independent of volume. Alpha = 1/N.
//@field rollingVolume Current volume relative to the exact rolling volume of the
//                     last N processing observations.
//@field minuteVolume Current volume relative to a settled minute-domain reference
//                    population of horizon N.
//@field hourlyVolume Current volume relative to a settled hourly-domain reference
//                    population of horizon N.
//@field dailyVolume Current volume relative to a settled daily-domain reference
//                   population of horizon N.
//@field weeklyVolume Current volume relative to a settled weekly-domain reference
//                    population of horizon N.
//@field monthlyVolume Current volume relative to a settled monthly-domain reference
//                     population of horizon N.
//@field openInterest Current traded volume relative to latest available EOD Open Interest.
//@field floatTurnover Current traded volume relative to reported Float Shares Outstanding.
//@field fundTurnover Current traded fund units relative to the latest available
//                    AUM/NAV-implied outstanding fund-unit population.
export enum ParticipationModel
    none          = "No Participation"
    equal         = "Equal Participation (1/N)"
    rollingVolume = "Rolling Volume"
    minuteVolume  = "Settled Minute Volume"
    hourlyVolume  = "Settled Hourly Volume"
    dailyVolume   = "Settled Daily Volume"
    weeklyVolume  = "Settled Weekly Volume"
    monthlyVolume = "Settled Monthly Volume"
    openInterest  = "Open-Interest Turnover"
    floatTurnover = "Float Turnover"
    fundTurnover  = "Fund Turnover"


//@enum Defines recursive dimensionless market-dispersion evidence models.
//@field meanDisplacement Price displacement from the retained recursive mean.
//@field realized Close-to-close realized-return dispersion.
//@field drawDown Downward displacement from a recursively retained peak.
//@field upThrust Upward displacement from a recursively retained trough.
//@field stressPeaks Dominant magnitude between recursive DrawDown and UpThrust.
//@field stressAverage Arithmetic mean of recursive DrawDown and UpThrust magnitudes.
export enum DispersionModel
    meanDisplacement = "Mean Displacement"
    realized         = "Realized Return Dispersion"
    drawDown         = "Recursive DrawDown"
    upThrust         = "Recursive UpThrust"
    stressPeaks      = "Maximum [DrawDown,UpThrust]"
    stressAverage    = "Average [DrawDown,UpThrust]"


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PUBLIC STREAMING STATE TYPES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━


//@type Persistent state of a first-order Infinite Impulse Response recursion.
//@field value Current recursively estimated state.
export type IIR1State
    float value = na


//@type Persistent sample-and-hold state.
//
// Stores the most recently sampled observation whenever a supplied
// trigger condition becomes true.
//
//@field value Last sampled observation.
export type SampleHoldState
    float value = na


//@type Persistent conditional settlement state.
//
// Tracks the latest developing observation and preserves its final value
// whenever a supplied settlement condition becomes true.
//
//@field developing Latest valid developing observation.
//@field settled Most recently completed settled observation.
export type SettlementState
    float developing = na
    float settled = na


//@type Persistent accumulation state.
//
// Stores a running sum of valid observations until a supplied reset
// condition begins a new accumulation sequence.
//
//@field value Current accumulated value.
export type AccumulatorState
    float value = na


//@type Persistent recursive extrema estimator state.
//
// Unlike finite-window highest/lowest calculations, these states retain
// newly observed extrema immediately and asymptotically release toward
// subsequent observations.
//
//@field peak Current recursively retained upper extreme.
//@field trough Current recursively retained lower extreme.
export type ExtremaState
    float peak   = na
    float trough = na


//@type Persistent P² streaming quantile estimator state.
//
// Maintains the fixed five-marker state required by the P² dynamic quantile
// estimator for one predefined quantile probability.
//
// The estimator approximates the requested quantile of the cumulative
// observation population without retaining the full population.
//
// During the first five valid observations, `markerHeights` temporarily
// retains the bootstrap population. Once initialized, the arrays represent
// the five P² markers.
//
// Algorithmic foundation:
//     Jain, R. and Chlamtac, I. (1985).
//     "The P² Algorithm for Dynamic Calculation of Quantiles and Histograms
//     Without Storing Observations."
//     Communications of the ACM 28(10), 1076-1085.
//     DOI: 10.1145/4372.4378
//
// This implementation incorporates numerical and initialization refinements
// analyzed by Andrey Akinshin, including direct desired-position reconstruction,
// adaptive initialization, and probability-dependent marker adjustment order.
//
// The desired-position reconstruction addresses a numerical issue reported
// by Anthony Lloyd and subsequently analyzed by Akinshin.
//
//@field value Current P² quantile estimate.
//@field probability Quantile probability bound to the current population.
//@field markerHeights Five P² marker heights.
//@field markerPositions Five integer marker positions.
//@field desiredPositions Five real-valued desired marker positions.
//@field count Number of valid observations processed since initialization/reset.
export type P2QuantileState
    float value = na
    float probability = na

    array<float> markerHeights
    array<int> markerPositions
    array<float> desiredPositions

    int count = 0


//@type Persistent recursively adaptive quantile estimator state.
//
// Tracks one predefined quantile probability using a stochastic quantile-score
// recursion with an internally retained absolute-innovation scale.
//
// The retained scale converts the dimensionless recursive coefficient into a
// dimensioned quantile update:
//
//     step = alpha * previousScale
//
// The quantile update always uses the scale retained before the current
// observation. The current innovation updates scale only for subsequent
// observations.
//
// Unlike P², this state does not represent the cumulative empirical quantile
// of all observations since initialization. It is a recursive quantile tracker
// whose adaptation rate is controlled by the supplied coefficient.
//
//@field value Current recursively tracked quantile estimate.
//@field probability Quantile probability bound to the active recursive state.
//@field scale Recursive absolute-innovation scale in input units.
export type AdaptiveQuantileState
    float value = na
    float probability = na
    float scale = na


//@type Persistent recursively adaptive expectile estimator state.
//
// Tracks one predefined expectile level using an asymmetric least-squares
// recursion.
//
// For innovation:
//
//     innovation = input - previousValue
//
// the asymmetric observation weight is:
//
//     level       when innovation > 0
//     1 - level   when innovation < 0
//
// and the recursive correction is:
//
//     value += alpha * weight * innovation
//
// Unlike AdaptiveQuantileState, no auxiliary scale state is required because
// the innovation itself supplies the dimensioned update magnitude.
//
// Expectile level controls both the stationary asymmetric least-squares target
// and directional responsiveness:
//
//     level < 0.5
//         Greater response to observations below the retained state.
//
//     level > 0.5
//         Greater response to observations above the retained state.
//
//     level = 0.5
//         Symmetric squared-loss location target.
//
// The expectile level is bound to the active recursive state and cannot change
// without an explicit reset.
//
//@field value Current recursively tracked expectile estimate.
//@field level Expectile level bound to the active recursive state.
export type AdaptiveExpectileState
    float value = na
    float level = na


//@type Persistent exponentially weighted conditional tail-mean state.
//
// Tracks an observation-clock exponentially weighted conditional mean relative
// to an externally supplied tail threshold.
//
// For each valid positive-weight observation, tail membership is:
//
//     lower:
//         indicator = 1 when input <= threshold
//                     0 otherwise
//
//     upper:
//         indicator = 1 when input >= threshold
//                     0 otherwise
//
// The retained state follows:
//
//     weightedTail =
//         (1 - alpha) * previousWeightedTail
//         + alpha * indicator * input
//
//     tailMass =
//         (1 - alpha) * previousTailMass
//         + alpha * indicator
//
// and, whenever retained tail mass is numerically positive:
//
//     value = weightedTail / tailMass
//
// A non-tail observation decays weightedTail and tailMass by the same factor,
// preserving an already-defined normalized tail mean.
//
// A tail observation performs a normalized update toward the current tail
// observation.
//
// The threshold is external state and may vary from observation to observation.
// It is deliberately not bound to this object. For example, a caller may
// supply a recursively adaptive quantile as the threshold.
//
// The selected TailSide is bound to the active recursive state and cannot
// change without an explicit reset.
//
// Tail side becomes bound when the first valid observation with positive
// clamped alpha begins the recursive sequence, even if that observation is
// outside the selected tail.
//
// Alpha is an observation-clock recursive coefficient and is clamped to [0,1].
//
// A zero alpha is a valid zero-weight observation. It preserves existing state
// and does not initialize an empty state.
//
// Missing input, threshold, or alpha preserves the complete retained state.
//
// When the supplied threshold is the corresponding quantile of a continuous
// population, this estimator targets the corresponding conditional tail
// expectation and therefore has the usual Expected Shortfall / CVaR
// interpretation under the selected sign convention.
//
// For populations containing probability mass exactly at the threshold, the
// generic conditional tail mean must not automatically be identified with the
// canonical quantile-integral Expected Shortfall definition.
//
//@field value Current normalized conditional tail mean.
//@field weightedTail Exponentially weighted tail-value numerator.
//@field tailMass Exponentially weighted tail-membership mass.
//@field side Tail side bound to the active recursive state.
export type AdaptiveTailMeanState
    float value = na

    float weightedTail = 0.0
    float tailMass = 0.0

    TailSide side = na


//@type Persistent recursively adaptive Huber-location state.
//
// Tracks a robust location using a clipped innovation:
//
//     innovation = input - value
//
//     limit = tuning * scale
//
//     correction = clamp(
//         innovation,
//         -limit,
//         +limit
//     )
//
//     value += alpha * correction
//
// Inside the clipping region:
//
//     abs(innovation) <= tuning * scale
//
// the recursion is exactly the ordinary first-order IIR update:
//
//     value += alpha * innovation
//
// Outside the clipping region, one-observation influence is bounded:
//
//     abs(delta value)
//         <= alpha * tuning * scale
//
// Scale is supplied externally and may vary from observation to observation.
// The state deliberately does not own or update a dispersion estimator.
//
// Tuning is dimensionless, must be strictly positive, and is bound to the
// active state. It cannot change without an explicit reset.
//
// Alpha is the literal recursive update coefficient and is clamped to [0,1].
// No distribution-specific bandwidth normalization is performed internally.
//
// A zero scale is valid. After initialization it produces zero correction and
// therefore freezes the retained location.
//
// The first valid observation initializes directly from input regardless of
// alpha or scale. Consequently alpha = 0 or scale = 0 may initialize an empty
// state.
//
// Missing input, scale, or alpha preserves the complete retained state.
//
//@field value  Current recursively tracked robust location.
//@field tuning Positive Huber clipping constant bound to the active state.
export type AdaptiveHuberState
    float value = na
    float tuning = na


//@type Persistent normalized exponentially weighted univariate central-moment
// state.
//
// Represents one normalized recursively weighted observation population using
// sufficient statistics through the fourth central moment.
//
// For an initialized state and a clamped coefficient strictly between zero and
// one, the update uses the previous mean and central moments:
//
//     delta = input - previousMean
//
//     mean =
//         previousMean
//         + alpha * delta
//
//     m2 =
//         (1-alpha) * previousM2
//         + alpha * (1-alpha) * delta^2
//
//     m3 =
//         (1-alpha) * previousM3
//         - 3 * alpha * (1-alpha) * delta * previousM2
//         + alpha * (1-alpha) * (1 - 2*alpha) * delta^3
//
//     m4 =
//         (1-alpha) * previousM4
//         - 4 * alpha * (1-alpha) * delta * previousM3
//         + 6 * alpha^2 * (1-alpha) * delta^2 * previousM2
//         + alpha * (1-alpha)
//             * (1 - 3*alpha*(1-alpha)) * delta^4
//
// The state additionally tracks normalized-weight concentration:
//
//     weightSquareSum =
//         (1-alpha)^2 * previousWeightSquareSum
//         + alpha^2
//
// Alpha is clamped to [0,1]. The first valid observation initializes a
// singleton population directly regardless of the clamped alpha, including
// alpha = 0. Active alpha = 0 freezes the complete population. Active alpha =
// 1 replaces it with the current singleton.
//
// Missing input or alpha preserves the complete retained state.
//
//@field mean            Current exponentially weighted population mean.
//@field m2              Raw exponentially weighted second central moment.
//@field m3              Raw exponentially weighted third central moment.
//@field m4              Raw exponentially weighted fourth central moment.
//@field weightSquareSum Sum of squared normalized observation weights.
export type AdaptiveMomentsState
    float mean = na
    float m2 = 0.0
    float m3 = 0.0
    float m4 = 0.0
    float weightSquareSum = 1.0


//@type Persistent exponentially weighted bivariate central-moment state.
//
// Tracks paired observations x and y using one common exponentially weighted
// population.
//
// For previous means meanX and meanY:
//
//     dx = x - meanX
//     dy = y - meanY
//
//     meanX += alpha * dx
//     meanY += alpha * dy
//
//     varianceX =
//         (1-alpha)
//         * (varianceX + alpha * dx^2)
//
//     varianceY =
//         (1-alpha)
//         * (varianceY + alpha * dy^2)
//
//     covariance =
//         (1-alpha)
//         * (covariance + alpha * dx * dy)
//
// The state additionally tracks normalized-weight concentration:
//
//     weightSquareSum =
//         (1-alpha)^2 * previousWeightSquareSum
//         + alpha^2
//
// For IID paired observations with deterministic or observation-independent
// recursive weights, raw central moments have finite-weight expectation
// multiplied by:
//
//     1 - weightSquareSum
//
// Corrected covariance and variances therefore divide by that factor when
// strictly positive.
//
// Correlation requires no common-factor correction:
//
//     covariance
//     / sqrt(varianceX * varianceY)
//
// The correlation ratio can still possess ordinary finite-effective-sample
// statistical bias. No additional correlation correction is performed.
//
// Alpha is clamped to [0,1].
//
// The first valid paired observation initializes both means directly, all
// central moments to zero, and weightSquareSum to one.
//
// Missing x, y, or alpha preserves the complete retained state.
//
//@field meanX           Current exponentially weighted X mean.
//@field meanY           Current exponentially weighted Y mean.
//@field varianceX       Raw exponentially weighted X central second moment.
//@field varianceY       Raw exponentially weighted Y central second moment.
//@field covariance      Raw exponentially weighted XY central cross-moment.
//@field weightSquareSum Sum of squared normalized observation weights.
export type AdaptiveCovarianceState
    float meanX = na
    float meanY = na
    float varianceX = 0.0
    float varianceY = 0.0
    float covariance = 0.0
    float weightSquareSum = 1.0


//@type Persistent recursively weighted Heavy-Tail distribution state.
//
// Stores recursively weighted central moments together with the derived
// distribution statistics required by the recursive estimation framework.
//
//@field moments Generic recursively weighted central-moment population state.
//@field absInnovation recursively weighted absolute innovation.
//@field sigma Recursive standard scale sqrt(m2).
//@field tScale Student-t variance-equivalent scale derived from sigma and
//              effective df.
//@field absInnovationScale Gaussian-equivalent recursively weighted absolute-innovation
//                   scale.
//@field df Effective bounded Student-t degrees of freedom.
//@field kurtosis Recursively weighted Pearson kurtosis m4 / m2².
export type HeavyTailState
    AdaptiveMomentsState moments

    float absInnovation = 0.0

    float sigma         = 0.0
    float tScale        = 0.0
    float absInnovationScale   = 0.0

    float df            = 30.0
    float kurtosis      = 3.0


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PRIVATE MATHEMATICAL HELPERS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

//@function
// Constrains a numeric value to the inclusive interval [lower, upper].
//
//@param value  Input value.
//@param lower  Minimum permitted value.
//@param upper  Maximum permitted value.
//@returns       Input value constrained to [lower, upper].
clamp(
    float value,
    float lower,
    float upper
) =>
    math.max(
        lower,
        math.min(
            upper,
            value
        )
    )


//@function
// Reconstructs the non-negative root second raw moment from
// a distribution's mean and standard deviation:
//
//     RMS = sqrt(mean² + sigma²)
//
//@param mean   Distribution location.
//@param sigma  Distribution standard scale.
//@returns      Root second raw moment.
rootSecondMoment(
    float mean,
    float sigma
) =>
    math.sqrt(
        math.max(
            mean * mean + sigma * sigma,
            0.0
        )
    )


//@function
// Rounds a numeric value to the nearest integer using half-to-even
// midpoint resolution.
//
// This helper provides explicit deterministic midpoint behavior required by
// the adaptive P² initialization procedure.
//
//@param value Input numeric value.
//@returns      Nearest integer using half-to-even rounding.
roundHalfToEven(
    float value
) =>

    int lower = int(
        math.floor(value)
    )

    float fraction =
         value - float(lower)

    int output = fraction < 0.5
         ? lower
         : fraction > 0.5
             ? lower + 1
             : lower % 2 == 0
                 ? lower
                 : lower + 1

    output



//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PUBLIC MATHEMATICAL TRANSFORMS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━


//@function
// Constructs a dimensionless relative return between a current observation
// and a reference observation.
//
// Arithmetic return:
//     current / reference - 1
//
// Logarithmic return:
//     ln(current / reference)
//
// The arithmetic-return model requires a non-zero reference.
//
// The logarithmic-return model requires both current and reference
// observations to be strictly positive.
//
// Invalid mathematical domains return na.
//
//@param model      Selected ReturnModel.
//@param current    Current observation.
//@param reference  Reference observation.
//@returns           Dimensionless relative return, or na when undefined.
export relativeReturn(
    simple ReturnModel model,
    float current,
    float reference
) =>

    float output = switch model

        ReturnModel.arithmetic =>
            not na(current) and not na(reference)
             and reference != 0.0
                 ? current / reference - 1.0
                 : na

        ReturnModel.logarithmic =>
            not na(current) and not na(reference)
             and current > 0.0 and reference > 0.0
                 ? math.log(current / reference)
                 : na

    output


//@function
// Reconstructs an observation from a reference value and a dimensionless
// relative displacement.
//
// Arithmetic:
//     current = reference * (1 + displacement)
//
// Logarithmic:
//     current = reference * exp(displacement)
//
// The arithmetic model requires a non-zero reference.
//
// The logarithmic model requires a strictly positive reference.
//
// Invalid mathematical domains return na.
//
//@param model        Selected ReturnModel.
//@param reference    Reference observation.
//@param displacement Signed dimensionless relative displacement.
//@returns             Reconstructed observation, or na when undefined.
export relativeProjection(
    simple ReturnModel model,
    float reference,
    float displacement
) =>

    float output = switch model

        ReturnModel.arithmetic =>
            not na(reference) and not na(displacement)
             and reference != 0.0
                 ? reference * (1.0 + displacement)
                 : na

        ReturnModel.logarithmic =>
            not na(reference) and not na(displacement)
             and reference > 0.0
                 ? reference * math.exp(displacement)
                 : na

    output


//@function
// Scales the first two moments of an additive increment distribution from a
// base horizon to a target horizon.
//
// The target-to-base horizon ratio is:
//     H = targetHorizon / baseHorizon
//
// Under linear aggregation of the first moment and linear aggregation of
// variance:
//     scaledMean  = H * mean
//     scaledSigma = sqrt(H) * sigma
//
// The corresponding non-negative root second raw moment is:
//     scaledRms = sqrt(scaledMean² + scaledSigma²)
//               = sqrt(H² * mean² + H * sigma²)
//
// This transform is appropriate only when the supplied observations represent
// additive increments and the assumed horizon aggregation supports linear
// first-moment and variance scaling.
//
// In particular, sigma scaling assumes that serial covariance across aggregated
// increments is negligible or otherwise consistent with:
//     Var(sum of H increments) = H * sigma²
//
// The transform is therefore a horizon-scaling model, not a claim that market
// returns are independent or exactly diffusive.
//
// Logarithmic returns are additive across consecutive return intervals.
// Arithmetic simple returns are not additive and must not be interpreted as
// exact multi-period returns through this transform.
//
// Integer horizon ratios correspond directly to aggregation across repeated
// base-horizon increments under the stated assumptions. Non-integer ratios
// represent a continuous horizon-scaling assumption rather than a literal
// discrete observation count.
//
// Missing mean, sigma, or horizonRatio inputs return na outputs.
//
// A non-positive horizonRatio is an invalid model configuration and generates
// a runtime error.
//
// A negative sigma is structurally invalid for a standard-deviation input and
// generates a runtime error.
//
//@param mean         Base-horizon distribution mean.
//@param sigma        Base-horizon distribution standard deviation.
//@param horizonRatio Positive target-to-base horizon ratio.
//@returns             Tuple [scaledMean, scaledSigma, scaledRms].
export additiveMomentScale(
    series float mean,
    series float sigma,
    series float horizonRatio
) =>

    if not na(horizonRatio) and horizonRatio <= 0.0
        runtime.error(
            "Additive moment horizon ratio must be greater than zero."
        )

    if not na(sigma) and sigma < 0.0
        runtime.error(
            "Additive moment sigma must be non-negative."
        )

    bool validObservation =
         not na(mean)
         and not na(sigma)
         and not na(horizonRatio)

    float scaledMean = validObservation
         ? horizonRatio * mean
         : na

    float scaledSigma = validObservation
         ? math.sqrt(horizonRatio) * sigma
         : na

    float scaledRms = validObservation
         ? rootSecondMoment(
             scaledMean,
             scaledSigma
         )
         : na

    [ scaledMean,
      scaledSigma,
      scaledRms ]


//@function
// Converts a raw median absolute deviation into the conventional
// Gaussian-equivalent robust scale.
//
// For a standard Normal population:
//
//     MAD = Phi^-1(0.75)
//         ~= 0.6744897501960817
//
// therefore:
//
//     gaussianScale
//         = MAD / Phi^-1(0.75)
//         ~= 1.482602218505602 * MAD
//
// This conversion is a scale convention, not an assertion that the
// underlying population is Gaussian.
//
// For non-Gaussian populations, the returned value remains a robust
// Gaussian-equivalent scale and generally does not equal standard deviation.
//
// Missing MAD returns na.
//
//@param mad Raw non-negative median absolute deviation.
//@returns   Gaussian-equivalent robust scale.
export gaussianScaleFromMAD(
    series float mad
) =>

    not na(mad)
         ? mad
             * MAD_TO_GAUSSIAN_SCALE
         : na



//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MARKET DATA HELPERS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━


//@function
// Requests the latest available End-Of-Day Open Interest observation.
//
// TradingView Open Interest feeds use ticker IDs in the form:
//     <tickerid>_OI
//
// The function deliberately requests the latest published 1D closing
// Open Interest value.
//
// It does not offset the OI series with [1], because EOD Open Interest
// itself is a reported/settled data series. Applying an additional
// historical offset would introduce one extra report of latency.
//
// If no compatible Open Interest feed exists, the function returns na.
//
//@param symbol TradingView ticker ID. Empty string uses the chart symbol.
//@returns       Latest available End-Of-Day Open Interest, or na.
export openInterestEOD(
    simple string symbol = ""
) =>

    string requestedSymbol = str.length(symbol) > 0
         ? ticker.standard(symbol)
         : ticker.standard(syminfo.tickerid)

    string openInterestSymbol =
         requestedSymbol + "_OI"

    float reportedOpenInterest = request.security(
        openInterestSymbol,
        "1D",
        close,
        gaps = barmerge.gaps_off,
        lookahead = barmerge.lookahead_off,
        ignore_invalid_symbol = true
    )

    reportedOpenInterest


//@function
// Returns the latest available reported Float Shares Outstanding.
//
// The helper first requests TradingView's current float-shares metadata for the
// standardized symbol. When that value is unavailable, it falls back to the
// FLOAT_SHARES_OUTSTANDING FY financial metric.
//
// Both sources represent the same free-float population; the fallback therefore
// preserves the economic definition of the returned quantity.
//
// Float Shares Outstanding represents the portion of issued common shares
// available for open-market trading.
//
// If neither compatible source is available, the function returns na.
//
//@param symbol TradingView ticker ID. Empty string uses the chart symbol.
//@returns       Latest available reported Float Shares Outstanding, or na.
export floatSharesOutstanding(
    simple string symbol = ""
) =>

    string requestedSymbol = str.length(symbol) > 0
         ? ticker.standard(symbol)
         : ticker.standard(syminfo.tickerid)

    float currentReportedFloat = request.security(
        requestedSymbol,
        timeframe.period,
        syminfo.shares_outstanding_float,
        gaps = barmerge.gaps_off,
        ignore_invalid_symbol = true
    )

    float financialReportedFloat = request.financial(
        requestedSymbol,
        "FLOAT_SHARES_OUTSTANDING",
        "FY",
        gaps = barmerge.gaps_off,
        ignore_invalid_symbol = true
    )

    not na(currentReportedFloat)
         ? currentReportedFloat
         : financialReportedFloat


//@function
// Returns the latest available implied outstanding fund-unit population.
//
// The population is derived from TradingView's reported Assets Under
// Management and per-unit Net Asset Value:
//
//     impliedFundUnits = AUM / NAV
//
// This is a derived population rather than a directly reported shares-
// outstanding field.
//
// Missing or structurally invalid reported data returns na.
//
//@param symbol TradingView fund or ETF symbol.
//               Empty string uses the current chart symbol.
//@returns Latest available implied outstanding fund-unit population,
//         or na when the required reported data is unavailable.
export fundUnitsOutstanding(
    simple string symbol = ""
) =>

    string requestedSymbol = str.length(symbol) > 0
         ? ticker.standard(symbol)
         : ticker.standard(syminfo.tickerid)

    float reportedNAV = request.financial(
        requestedSymbol,
        "NAV",
        "D",
        gaps = barmerge.gaps_off,
        ignore_invalid_symbol = true
    )

    float reportedAUM = request.financial(
        requestedSymbol,
        "AUM",
        "D",
        gaps = barmerge.gaps_off,
        ignore_invalid_symbol = true
    )

    float impliedFundUnits =
         not na(reportedNAV)
         and reportedNAV > 0.0
         and not na(reportedAUM)
         and reportedAUM > 0.0
         ? reportedAUM / reportedNAV
         : na

    impliedFundUnits



//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// STREAMING STATE METHODS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━


//@function
// Updates a persistent first-order Infinite Impulse Response state.
//
// The recursion is:
//     y[t] = b0 * x[t] + a1 * y[t-1]
//
// where:
//     b0 = coefficient
//     a1 = 1 - b0
//
// unless an explicit feedback coefficient is supplied.
//
// When the state has not been initialized, `init` is used as the previous
// recursive state. If `init` is na, the current input is used as the seed.
//
// Missing input or coefficient observations do not mutate the retained state.
//
// A coefficient of zero is valid. After initialization it produces no
// feed-forward contribution when complementary feedback is used.
//
// When feedback is explicitly supplied, the caller is responsible
// for choosing coefficients that produce the desired stable recursion.
//
// `feedback = na` deliberately selects complementary feedback:
//
//     a1 = 1 - coefficient
//
// It is therefore an API mode selector rather than a missing-observation
// condition. A dynamically na feedback series also selects complementary
// feedback for that observation.
//
//@param this        Persistent IIR1State object.
//@param input       Current observation.
//@param coefficient Recursive feed-forward coefficient: 0 <= coefficient <= 1.
//@param init        Optional initialization value.
//@param feedback    Optional explicit feedback coefficient.
//@returns            The updated IIR1State object.
export method update(
    IIR1State this,
    series float input,
    series float coefficient,
    series float init = na,
    series float feedback = na
) =>

    bool validObservation = not na(input) and not na(coefficient)

    if validObservation

        // Clamp the feed-forward coefficient.
        float b0 = clamp(
            coefficient,
            0.0,
            1.0
        )

        // Complementary feedback by default.
        float a1 = na(feedback)
             ? 1.0 - b0
             : feedback

        // Seed the recursion only when the object has no previous state.
        float previousState =
             na(this.value)
             ? nz(init, input)
             : this.value

        // Recursive update.
        this.value :=
             b0 * input + a1 * previousState

    // Invalid observations deliberately leave the retained state untouched.
    this


//@function
// Resets a persistent first-order Infinite Impulse Response state.
//
//@param this Persistent IIR1State object.
//@returns    The reset IIR1State object.
export method reset(
    IIR1State this
) =>

    this.value := na
    this


//@function
// Updates a persistent sample-and-hold state.
//
// When sampleWhen is true and the supplied input is valid, the current
// observation replaces the retained state.
//
// When sampleWhen is false, the previously sampled value is preserved.
//
// This is an O(1) online state update.
//
//@param this       Persistent SampleHoldState object.
//@param input      Observation available for sampling.
//@param sampleWhen Condition that causes the current observation to be retained.
//@returns           The mutated and updated SampleHoldState object.
export method update(
    SampleHoldState this,
    series float input,
    series bool sampleWhen
) =>

    if sampleWhen and not na(input)
        this.value := input

    this


//@function
// Resets a persistent sample-and-hold state.
//
//@param this Persistent SampleHoldState object.
//@returns    The reset SampleHoldState object.
export method reset(
    SampleHoldState this
) =>

    this.value := na
    this


//@function
// Updates a persistent conditional settlement state.
//
// When `settleWhen` becomes true, the previously developing value is first
// transferred to the settled state. The current input then begins the new
// developing state.
//
// Between settlements, valid inputs continuously replace the developing value.
//
//@param this       Persistent SettlementState object.
//@param input      Current developing observation.
//@param settleWhen Condition that settles the previous developing value.
//@returns       The updated SettlementState object.
export method update(
    SettlementState this,
    series float input,
    series bool settleWhen
) =>

    if settleWhen
        this.settled    := this.developing
        this.developing := input

    else if not na(input)
        this.developing := input

    this


//@function
// Resets a persistent conditional settlement state.
//
//@param this Persistent SettlementState object.
//@returns    The reset SettlementState object.
export method reset(
    SettlementState this
) =>

    this.developing := na
    this.settled    := na
    this


//@function
// Updates a persistent accumulation state.
//
// When `resetWhen` is true, the current observation begins a new accumulation
// sequence.
//
// Otherwise, valid observations are added to the retained accumulated state.
//
// Missing observations are ignored between resets. If a reset occurs while
// the input is na, the new accumulation sequence remains uninitialized until
// its first valid observation.
//
// This is an O(1) online state update.
//
//@param this      Persistent AccumulatorState object.
//@param input     Current observation to accumulate.
//@param resetWhen Condition that begins a new accumulation sequence.
//@returns          The mutated and updated AccumulatorState object.
export method update(
    AccumulatorState this,
    series float input,
    series bool resetWhen
) =>

    if resetWhen
        this.value := input

    else if not na(input)
        this.value := na(this.value)
             ? input
             : this.value + input

    this


//@function
// Resets a persistent accumulation state.
//
//@param this Persistent AccumulatorState object.
//@returns    The reset AccumulatorState object.
export method reset(
    AccumulatorState this
) =>

    this.value := na
    this


//@function
// Updates a persistent recursive extrema state.
//
// New upper extremes attack immediately.
// Otherwise the retained peak asymptotically releases downward.
//
// New lower extremes attack immediately.
// Otherwise the retained trough asymptotically releases upward.
//
// Missing upper, lower, or coefficient observations do not mutate either
// retained extrema state.
//
// A coefficient of zero is valid. New extrema are still captured immediately,
// while previously retained extrema perform no asymptotic release.
//
// This is an O(1) recursive extrema estimator rather than an exact
// finite-window highest/lowest calculation.
//
//@param this        Persistent ExtremaState object.
//@param upperInput  Observation used for peak estimation.
//@param lowerInput  Observation used for trough estimation.
//@param coefficient Recursive release coefficient: 0 <= coefficient <= 1.
//@returns            The updated ExtremaState object.
export method update(
    ExtremaState this,
    series float upperInput,
    series float lowerInput,
    series float coefficient
) =>

    bool validObservation =
         not na(upperInput)
         and not na(lowerInput)
         and not na(coefficient)

    if validObservation

        float alpha = clamp(
            coefficient,
            0.0,
            1.0
        )

        if na(this.peak) or na(this.trough)

            this.peak   := upperInput
            this.trough := lowerInput

        else

            float previousPeak   = this.peak
            float previousTrough = this.trough

            this.peak := upperInput >= previousPeak
                 ? upperInput
                 : previousPeak
                     + alpha * (upperInput - previousPeak)

            this.trough := lowerInput <= previousTrough
                 ? lowerInput
                 : previousTrough
                     + alpha * (lowerInput - previousTrough)

    this


//@function
// Resets a persistent extrema state.
//
//@param this Persistent ExtremaState object.
//@returns    The reset ExtremaState object.
export method reset(
    ExtremaState this
) =>

    this.peak   := na
    this.trough := na
    this


//@function
// Resets a persistent P² streaming quantile estimator state.
//
// Existing five-marker storage is reused when already allocated.
// Uninitialized marker arrays are allocated lazily on first reset/use.
//
// The reset discards the previous quantile population and restores the
// estimator to its bootstrap state.
//
//@param this Persistent P2QuantileState object.
//@returns    The reset P2QuantileState object.
export method reset(
    P2QuantileState this
) =>

    this.value       := na
    this.probability := na
    this.count       := 0

    if na(this.markerHeights)
        this.markerHeights := array.new_float(
            5,
            na
        )
    else
        array.fill(
            this.markerHeights,
            na
        )

    if na(this.markerPositions)
        this.markerPositions := array.new_int(
            5,
            na
        )
    else
        array.fill(
            this.markerPositions,
            na
        )

    if na(this.desiredPositions)
        this.desiredPositions := array.new_float(
            5,
            na
        )
    else
        array.fill(
            this.desiredPositions,
            na
        )

    this


//@function
// Updates a persistent P² streaming quantile estimator state.
//
// The estimator requires five valid observations to initialize its marker
// population. Before five observations are available, valid inputs are retained
// as bootstrap observations and the quantile estimate remains undefined.
//
// On the fifth valid observation, the bootstrap population is sorted and the
// five P² markers are initialized using adaptive marker positions.
//
// Missing inputs do not mutate the retained estimator state.
//
// The requested probability is model configuration and must satisfy:
//     0 < probability < 1
//
// Invalid probability configuration generates a runtime error.
//
// Algorithmic foundation:
//     Jain, R. and Chlamtac, I. (1985).
//     "The P² Algorithm for Dynamic Calculation of Quantiles and Histograms
//     Without Storing Observations."
//
// Adaptive initialization follows the refinement analyzed by Andrey Akinshin,
// in which the initial interior marker positions are selected according to the
// requested quantile probability.
//
//
//@param this        Persistent P2QuantileState object.
//@param input       Current observation.
//@param probability Predefined quantile probability: 0 < probability < 1.
//@returns            The updated P2QuantileState object.
export method update(
    P2QuantileState this,
    series float input,
    simple float probability
) =>

    // Configuration validation.
    if na(probability)
         or probability <= 0.0
         or probability >= 1.0

        runtime.error(
            "P² quantile probability must be strictly between zero and one."
        )

    // A P² population is defined for one fixed quantile probability.
    //
    // Changing probability without resetting would invalidate the retained
    // marker geometry.
    if not na(this.probability)
         and this.probability != probability

        runtime.error(
            "P² quantile probability cannot change within an active population."
        )

    bool validObservation =
         not na(input)

    if validObservation

        // Lazily allocate the reusable five-marker storage.
        if na(this.markerHeights)
            this.reset()

        // Bind the requested probability when the first valid observation
        // begins a new population.
        if na(this.probability)
            this.probability := probability

        // ---------------------------------------------------------------------
        // FIVE-OBSERVATION BOOTSTRAP
        // ---------------------------------------------------------------------
        if this.count < 5

            array.set(
                this.markerHeights,
                this.count,
                input
            )

            this.count += 1

            // The P² estimator becomes defined only after five valid
            // observations initialize the marker population.
            if this.count == 5

                array.sort(
                    this.markerHeights,
                    order.ascending
                )

                // Adaptive actual marker positions.
                int n1 = roundHalfToEven(
                    2.0 * probability
                )

                int n2 = roundHalfToEven(
                    4.0 * probability
                )

                int n3 = roundHalfToEven(
                    2.0 + 2.0 * probability
                )

                // Capture the selected bootstrap marker heights before mutating
                // the sorted five-observation storage.
                float initialQ1 = array.get(
                    this.markerHeights,
                    n1
                )

                float initialQ2 = array.get(
                    this.markerHeights,
                    n2
                )

                float initialQ3 = array.get(
                    this.markerHeights,
                    n3
                )

                array.set(
                    this.markerPositions,
                    0,
                    0
                )

                array.set(
                    this.markerPositions,
                    1,
                    n1
                )

                array.set(
                    this.markerPositions,
                    2,
                    n2
                )

                array.set(
                    this.markerPositions,
                    3,
                    n3
                )

                array.set(
                    this.markerPositions,
                    4,
                    4
                )

                // Adaptive marker heights selected from the sorted
                // five-observation bootstrap population.
                array.set(
                    this.markerHeights,
                    1,
                    initialQ1
                )

                array.set(
                    this.markerHeights,
                    2,
                    initialQ2
                )

                array.set(
                    this.markerHeights,
                    3,
                    initialQ3
                )

                // Desired marker positions for a five-observation
                // initialized P² population.
                array.set(
                    this.desiredPositions,
                    0,
                    0.0
                )

                array.set(
                    this.desiredPositions,
                    1,
                    2.0 * probability
                )

                array.set(
                    this.desiredPositions,
                    2,
                    4.0 * probability
                )

                array.set(
                    this.desiredPositions,
                    3,
                    2.0 + 2.0 * probability
                )

                array.set(
                    this.desiredPositions,
                    4,
                    4.0
                )

                // q₂ is the requested P² quantile marker.
                this.value := array.get(
                    this.markerHeights,
                    2
                )

        // ---------------------------------------------------------------------
        // POST-BOOTSTRAP P² UPDATE
        // ---------------------------------------------------------------------
        else

            float q0 = array.get(
                this.markerHeights,
                0
            )

            float q1 = array.get(
                this.markerHeights,
                1
            )

            float q2 = array.get(
                this.markerHeights,
                2
            )

            float q3 = array.get(
                this.markerHeights,
                3
            )

            float q4 = array.get(
                this.markerHeights,
                4
            )

            // Identify the marker interval containing the current observation.
            //
            // Extreme observations immediately replace q0 or q4.
            int k = 0

            if input < q0

                array.set(
                    this.markerHeights,
                    0,
                    input
                )

                k := 0

            else if input < q1
                k := 0

            else if input < q2
                k := 1

            else if input < q3
                k := 2

            else if input < q4
                k := 3

            else

                array.set(
                    this.markerHeights,
                    4,
                    input
                )

                k := 3

            // Every actual marker above the identified interval advances
            // by one observation position.
            //
            // The loop remains fixed at five markers, so update cost is O(1).
            for i = 0 to 4

                if i > k

                    int markerPosition = array.get(
                        this.markerPositions,
                        i
                    )

                    array.set(
                        this.markerPositions,
                        i,
                        markerPosition + 1
                    )

            // Directly reconstruct desired marker positions instead of
            // recursively accumulating their increments.
            //
            // `count` is the number of observations preceding the current
            // one, which equals N - 1 for the newly expanded population.
            float populationSpan =
                 float(this.count)

            array.set(
                this.desiredPositions,
                0,
                0.0
            )

            array.set(
                this.desiredPositions,
                1,
                populationSpan * probability / 2.0
            )

            array.set(
                this.desiredPositions,
                2,
                populationSpan * probability
            )

            array.set(
                this.desiredPositions,
                3,
                populationSpan * (1.0 + probability) / 2.0
            )

            array.set(
                this.desiredPositions,
                4,
                populationSpan
            )

            // -----------------------------------------------------------------
            // INTERIOR MARKER ADJUSTMENT
            // -----------------------------------------------------------------
            //
            // Adaptive initialization can temporarily produce coincident
            // marker positions for extreme probabilities.
            //
            // Adjustment order therefore follows the probability-dependent
            // refinement:
            //     probability >= 0.5 -> 1, 2, 3
            //     probability <  0.5 -> 3, 2, 1
            //
            // Each eligible marker first attempts the P² parabolic prediction.
            // If that prediction is undefined or would violate marker-height
            // ordering, linear interpolation is used instead.
            for step = 1 to 3

                int i = probability >= 0.5
                     ? step
                     : 4 - step

                int previousPosition = array.get(
                    this.markerPositions,
                    i - 1
                )

                int currentPosition = array.get(
                    this.markerPositions,
                    i
                )

                int nextPosition = array.get(
                    this.markerPositions,
                    i + 1
                )

                float desiredPosition = array.get(
                    this.desiredPositions,
                    i
                )

                float positionError =
                     desiredPosition - float(currentPosition)

                bool moveUp =
                     positionError >= 1.0
                     and nextPosition - currentPosition > 1

                bool moveDown =
                     positionError <= -1.0
                     and currentPosition - previousPosition > 1

                if moveUp or moveDown

                    int direction = moveUp
                         ? 1
                         : -1

                    float previousHeight = array.get(
                        this.markerHeights,
                        i - 1
                    )

                    float currentHeight = array.get(
                        this.markerHeights,
                        i
                    )

                    float nextHeight = array.get(
                        this.markerHeights,
                        i + 1
                    )

                    int leftGap =
                         currentPosition - previousPosition

                    int rightGap =
                         nextPosition - currentPosition

                    int fullGap =
                         nextPosition - previousPosition

                    // Adaptive initialization may temporarily leave coincident
                    // markers. The classical parabolic expression is undefined
                    // when either neighboring position gap is zero.
                    bool parabolicDefined =
                         leftGap != 0
                         and rightGap != 0
                         and fullGap != 0

                    float parabolicHeight = na

                    if parabolicDefined

                        parabolicHeight :=
                             currentHeight
                             + float(direction) / float(fullGap)
                             * (
                                 float(leftGap + direction)
                                     * (nextHeight - currentHeight)
                                     / float(rightGap)
                                 + float(rightGap - direction)
                                     * (currentHeight - previousHeight)
                                     / float(leftGap)
                             )

                    bool parabolicValid =
                         not na(parabolicHeight)
                         and previousHeight < parabolicHeight
                         and parabolicHeight < nextHeight

                    float adjustedHeight = parabolicHeight

                    if not parabolicValid

                        int neighborIndex =
                             i + direction

                        int neighborPosition = array.get(
                            this.markerPositions,
                            neighborIndex
                        )

                        float neighborHeight = array.get(
                            this.markerHeights,
                            neighborIndex
                        )

                        adjustedHeight :=
                             currentHeight
                             + float(direction)
                             * (neighborHeight - currentHeight)
                             / float(
                                 neighborPosition - currentPosition
                             )

                    array.set(
                        this.markerHeights,
                        i,
                        adjustedHeight
                    )

                    array.set(
                        this.markerPositions,
                        i,
                        currentPosition + direction
                    )

            // The current observation has now entered the population.
            this.count += 1

            this.value := array.get(
                this.markerHeights,
                2
            )

    // Return state after update or preservation.
    this


//@function
// Resets a persistent recursively adaptive quantile estimator state.
//
// The reset discards the retained quantile location, probability binding,
// and absolute-innovation scale.
//
//@param this Persistent AdaptiveQuantileState object.
//@returns    The reset AdaptiveQuantileState object.
export method reset(
    AdaptiveQuantileState this
) =>

    this.value       := na
    this.probability := na
    this.scale       := na

    this


//@function
// Updates a persistent recursively adaptive quantile estimator state.
//
// The estimator uses a quantile-score recursion with an internally retained
// absolute-innovation scale:
//
//     step = alpha * previousScale
//
//     value += step * quantileScore
//
// The current observation updates the retained scale only after the quantile
// correction has been determined, so the observation cannot determine its own
// update magnitude.
//
// Probability is bound to the active state and cannot change without an
// explicit reset.
//
// Missing input or alpha preserves the complete retained state. Alpha is
// clamped to [0, 1].
//
//@param this        Persistent AdaptiveQuantileState object.
//@param input       Observation used to update the recursive estimator.
//@param probability Quantile probability strictly between zero and one.
//@param alpha       Dimensionless recursive adaptation coefficient.
//@returns           The updated AdaptiveQuantileState object.
export method update(
    AdaptiveQuantileState this,
    series float input,
    simple float probability,
    series float alpha
) =>

    if (
        na(probability)
        or probability <= 0.0
        or probability >= 1.0
    )
        runtime.error(
            "probability must be strictly between zero and one"
        )

    if (
        not na(this.probability)
        and probability != this.probability
    )
        runtime.error(
            "probability cannot change inside an active population"
        )

    bool validObservation =
         not na(input)
         and not na(alpha)

    if validObservation

        float coefficient =
             clamp(
                 alpha,
                 0.0,
                 1.0
             )

        if na(this.value)

            this.value       := input
            this.probability := probability
            this.scale       := 0.0

        else

            float innovation =
                 input - this.value

            float previousScale =
                 this.scale

            float score = innovation > 0.0
                 ? probability
                 : innovation < 0.0
                     ? probability - 1.0
                     : 0.0

            float step =
                 coefficient
                 * previousScale

            this.value +=
                 step
                 * score

            this.scale :=
                 previousScale
                 + coefficient
                 * (
                     math.abs(innovation)
                     - previousScale
                 )

    this


//@function
// Resets a persistent recursively adaptive expectile estimator state.
//
// The reset discards the retained expectile location and level binding.
//
//@param this Persistent AdaptiveExpectileState object.
//@returns    The reset AdaptiveExpectileState object.
export method reset(
    AdaptiveExpectileState this
) =>

    this.value := na
    this.level := na

    this


//@function
// Updates a persistent recursively adaptive expectile estimator state.
//
// The estimator uses an asymmetric least-squares recursion:
//
//     innovation = input - previousValue
//
//     weight = level
//         when innovation > 0
//
//     weight = 1 - level
//         when innovation < 0
//
//     value += alpha * weight * innovation
//
// The supplied alpha is therefore a baseline recursive coefficient. The
// observation-specific effective coefficient is:
//
//     alpha * level
//
// for positive innovations, and:
//
//     alpha * (1 - level)
//
// for negative innovations.
//
// This directional asymmetry is intrinsic to expectile estimation and is not
// normalized away.
//
// Probability-style interpretation must not be applied to `level`: an expectile
// level specifies asymmetric squared-loss weighting rather than cumulative
// probability mass.
//
// Missing input or alpha preserves the complete retained state.
//
// Alpha is clamped to [0,1].
//
// A zero alpha is valid. It can initialize an empty state from the first valid
// observation, after which the retained estimate remains unchanged while alpha
// stays zero.
//
// Because alpha is constrained to [0,1] and the asymmetric weight lies in
// (0,1), a valid correction remains between the previous estimate and the
// current observation.
//
//@param this  Persistent AdaptiveExpectileState object.
//@param input Observation used to update the recursive estimator.
//@param level Expectile level strictly between zero and one.
//@param alpha Baseline dimensionless recursive adaptation coefficient.
//@returns     The updated AdaptiveExpectileState object.
export method update(
    AdaptiveExpectileState this,
    series float input,
    simple float level,
    series float alpha
) =>

    if (
        na(level)
        or level <= 0.0
        or level >= 1.0
    )
        runtime.error(
            "Expectile level must be strictly between zero and one."
        )

    if (
        not na(this.level)
        and level != this.level
    )
        runtime.error(
            "Expectile level cannot change inside an active state."
        )

    bool validObservation =
         not na(input)
         and not na(alpha)

    if validObservation

        float coefficient = clamp(
            alpha,
            0.0,
            1.0
        )

        if na(this.value)

            this.value := input
            this.level := level

        else

            float innovation =
                 input - this.value

            float asymmetricWeight =
                 innovation > 0.0
                 ? level
                 : innovation < 0.0
                     ? 1.0 - level
                     : 0.0

            this.value +=
                 coefficient
                 * asymmetricWeight
                 * innovation

    this


//@function
// Resets a persistent exponentially weighted conditional tail-mean state.
//
// The reset discards the normalized tail estimate, weighted tail-value
// numerator, retained tail mass, and tail-side binding.
//
//@param this Persistent AdaptiveTailMeanState object.
//@returns    The reset AdaptiveTailMeanState object.
export method reset(
    AdaptiveTailMeanState this
) =>

    this.value := na

    this.weightedTail := 0.0
    this.tailMass := 0.0

    this.side := na

    this


//@function
// Updates a persistent exponentially weighted conditional tail-mean state.
//
// For the selected tail:
//
//     lower:
//         indicator = 1 when input <= threshold
//
//     upper:
//         indicator = 1 when input >= threshold
//
// The observation-clock recursion is:
//
//     weightedTail =
//         (1 - alpha) * previousWeightedTail
//         + alpha * indicator * input
//
//     tailMass =
//         (1 - alpha) * previousTailMass
//         + alpha * indicator
//
//     value = weightedTail / tailMass
//
// whenever retained tail mass remains numerically positive.
//
// The supplied threshold is external and may change between observations.
//
// Tail side is bound to the active state and cannot change without reset.
//
// Configuration validation occurs before missing-observation handling.
//
// Missing input, threshold, or alpha preserves the complete retained state.
//
// Alpha is clamped to [0,1].
//
// Alpha = 0 performs no state mutation and does not bind the tail side of an
// empty state.
//
// For a positive clamped alpha, even a non-tail observation begins the active
// sequence and binds the supplied TailSide.
//
// A non-tail observation applied to an already-defined state decays numerator
// and denominator identically, preserving the normalized tail mean.
//
// An alpha of one applied to a tail observation produces complete replacement
// by that observation.
//
// An alpha of one applied to a non-tail observation clears retained effective
// tail mass and makes the normalized tail mean undefined while preserving the
// active side binding.
//
//@param this      Persistent AdaptiveTailMeanState object.
//@param input     Current observation.
//@param threshold Current external threshold defining tail membership.
//@param alpha     Observation-clock recursive coefficient.
//@param side      Fixed selected TailSide for the active recursive state.
//@returns         The updated AdaptiveTailMeanState object.
export method update(
    AdaptiveTailMeanState this,
    series float input,
    series float threshold,
    series float alpha,
    simple TailSide side
) =>

    if na(side)
        runtime.error(
            "Tail side must be defined."
        )

    if (
        not na(this.side)
        and side != this.side
    )
        runtime.error(
            "Tail side cannot change inside an active state."
        )

    bool validObservation =
         not na(input)
         and not na(threshold)
         and not na(alpha)

    if validObservation

        float coefficient = clamp(
            alpha,
            0.0,
            1.0
        )

        if coefficient > 0.0

            if na(this.side)
                this.side := side

            float indicator = switch side

                TailSide.lower =>
                    input <= threshold
                     ? 1.0
                     : 0.0

                TailSide.upper =>
                    input >= threshold
                     ? 1.0
                     : 0.0

            float retention =
                 1.0 - coefficient

            this.weightedTail :=
                 retention
                 * this.weightedTail
                 + coefficient
                 * indicator
                 * input

            this.tailMass :=
                 retention
                 * this.tailMass
                 + coefficient
                 * indicator

            this.value :=
                 this.tailMass > MIN_FLOAT
                 ? this.weightedTail
                     / this.tailMass
                 : na

    this


//@function
// Resets a persistent adaptive Huber-location state.
//
// The reset discards the retained location and tuning binding.
//
//@param this Persistent AdaptiveHuberState object.
//@returns    The reset AdaptiveHuberState object.
export method reset(
    AdaptiveHuberState this
) =>

    this.value := na
    this.tuning := na

    this


//@function
// Updates a persistent recursively adaptive Huber-location state.
//
// For retained location m and current observation x:
//
//     innovation = x - m
//
//     limit = tuning * scale
//
//     correction = clamp(
//         innovation,
//         -limit,
//         +limit
//     )
//
//     m += alpha * correction
//
// Scale is an external non-negative quantity expressed in the same units as
// input. It may change between observations.
//
// Tuning is fixed for the active state and must be strictly positive.
//
// Configuration validation occurs before missing-observation handling.
//
// Missing input, scale, or alpha preserves the complete retained state.
//
// Alpha is clamped to [0,1].
//
// The first valid observation initializes directly from input regardless of
// alpha or scale.
//
// Alpha = 0 therefore initializes an empty state but freezes an active state.
//
// A scale of zero is valid. It initializes an empty state normally and freezes
// subsequent updates because the clipping limit becomes zero.
//
// When the innovation lies inside the clipping region, this update is exactly
// equivalent to an ordinary first-order IIR update using the supplied alpha.
//
// No adjustment is made to compensate for the tuning-dependent effective
// statistical bandwidth.
//
//@param this   Persistent AdaptiveHuberState object.
//@param input  Current observation.
//@param scale  Current external non-negative scale in input units.
//@param tuning Fixed positive dimensionless Huber clipping constant.
//@param alpha  Recursive update coefficient.
//@returns      The updated AdaptiveHuberState object.
export method update(
    AdaptiveHuberState this,
    series float input,
    series float scale,
    simple float tuning,
    series float alpha
) =>

    if (
        na(tuning)
        or tuning <= 0.0
    )
        runtime.error(
            "Huber tuning must be strictly positive."
        )

    if (
        not na(this.tuning)
        and tuning != this.tuning
    )
        runtime.error(
            "Huber tuning cannot change inside an active state."
        )

    if (
        not na(scale)
        and scale < 0.0
    )
        runtime.error(
            "Huber scale cannot be negative."
        )

    bool validObservation =
         not na(input)
         and not na(scale)
         and not na(alpha)

    if validObservation

        float coefficient = clamp(
            alpha,
            0.0,
            1.0
        )

        if na(this.value)

            this.value := input
            this.tuning := tuning

        else

            float innovation =
                 input - this.value

            float limit =
                 tuning * scale

            float correction = clamp(
                innovation,
                -limit,
                limit
            )

            this.value +=
                 coefficient
                 * correction

    this


//@function
// Resets a persistent adaptive moment state.
//
// Restores the empty-state marker and neutral retained-field placeholders.
// The placeholders do not represent a statistical population while mean is
// na.
//
//@param this Persistent AdaptiveMomentsState object.
//@returns    The reset AdaptiveMomentsState object.
export method reset(
    AdaptiveMomentsState this
) =>

    this.mean := na
    this.m2 := 0.0
    this.m3 := 0.0
    this.m4 := 0.0
    this.weightSquareSum := 1.0

    this


//@function
// Updates a normalized exponentially weighted univariate moment population.
//
// Alpha is clamped to [0,1].
//
// Missing input or alpha preserves the complete retained state.
//
// The first valid observation initializes the normalized singleton population
// directly regardless of the clamped alpha, including alpha = 0.
//
// For an active population, alpha = 0 freezes every retained field exactly and
// alpha = 1 replaces the population with the current singleton observation.
//
// For 0 < alpha < 1, all central-moment updates use snapshots of the complete
// previous state. Newly updated lower moments are not used by higher-moment
// updates.
//
//@param this  Persistent AdaptiveMomentsState object.
//@param input Current observation.
//@param alpha Recursive weighting coefficient.
//@returns     The updated AdaptiveMomentsState object.
export method update(
    AdaptiveMomentsState this,
    series float input,
    series float alpha
) =>

    bool validObservation =
         not na(input)
         and not na(alpha)

    if validObservation

        float coefficient = clamp(
            alpha,
            0.0,
            1.0
        )

        if na(this.mean)

            this.mean := input
            this.m2 := 0.0
            this.m3 := 0.0
            this.m4 := 0.0
            this.weightSquareSum := 1.0

        else if coefficient >= 1.0

            this.mean := input
            this.m2 := 0.0
            this.m3 := 0.0
            this.m4 := 0.0
            this.weightSquareSum := 1.0

        else if coefficient > 0.0

            float oldMean = this.mean
            float oldM2 = this.m2
            float oldM3 = this.m3
            float oldM4 = this.m4
            float oldWeightSquareSum =
                 this.weightSquareSum

            float retention =
                 1.0 - coefficient

            float delta =
                 input - oldMean

            float delta2 =
                 delta * delta

            float delta3 =
                 delta2 * delta

            float delta4 =
                 delta2 * delta2

            this.mean :=
                 oldMean
                 + coefficient
                 * delta

            this.m2 :=
                 retention
                 * oldM2
                 + coefficient
                 * retention
                 * delta2

            this.m3 :=
                 retention
                 * oldM3
                 - 3.0
                 * coefficient
                 * retention
                 * delta
                 * oldM2
                 + coefficient
                 * retention
                 * (
                     retention
                     - coefficient
                 )
                 * delta3

            this.m4 :=
                 retention
                 * oldM4
                 - 4.0
                 * coefficient
                 * retention
                 * delta
                 * oldM3
                 + 6.0
                 * coefficient
                 * coefficient
                 * retention
                 * delta2
                 * oldM2
                 + coefficient
                 * retention
                 * (
                     1.0
                     - 3.0
                     * coefficient
                     * retention
                 )
                 * delta4

            this.weightSquareSum :=
                 retention
                 * retention
                 * oldWeightSquareSum
                 + coefficient
                 * coefficient

    this


//@function
// Returns the raw exponentially weighted population variance.
//
//@param this Persistent AdaptiveMomentsState object.
//@returns    Raw second central moment, or na while empty.
export method variance(
    AdaptiveMomentsState this
) =>

    not na(this.mean)
         ? this.m2
         : na


//@function
// Returns the finite-weight central-moment correction denominator:
//
//     1 - weightSquareSum
//
//@param this Persistent AdaptiveMomentsState object.
//@returns    Current correction denominator, or na while empty.
export method correctionDenominator(
    AdaptiveMomentsState this
) =>

    not na(this.mean)
         ? 1.0 - this.weightSquareSum
         : na


//@function
// Returns finite-weight corrected population variance when defined.
//
//@param this Persistent AdaptiveMomentsState object.
//@returns    Corrected variance, or na when empty or undefined.
export method correctedVariance(
    AdaptiveMomentsState this
) =>

    float denominator =
         this.correctionDenominator()

    (
        not na(denominator)
        and denominator > 0.0
    )
         ? this.m2 / denominator
         : na


//@function
// Returns raw exponentially weighted population sigma.
//
// A negative m2 is not clamped or otherwise altered.
//
//@param this Persistent AdaptiveMomentsState object.
//@returns    Square root of m2, or na when empty or m2 is negative.
export method sigma(
    AdaptiveMomentsState this
) =>

    (
        not na(this.mean)
        and this.m2 >= 0.0
    )
         ? math.sqrt(this.m2)
         : na


//@function
// Returns finite-weight corrected population sigma when defined.
//
//@param this Persistent AdaptiveMomentsState object.
//@returns    Square root of corrected variance, or na when undefined.
export method correctedSigma(
    AdaptiveMomentsState this
) =>

    float correctedValue =
         this.correctedVariance()

    (
        not na(correctedValue)
        and correctedValue >= 0.0
    )
         ? math.sqrt(correctedValue)
         : na


//@function
// Returns raw moment skewness:
//
//     m3 / m2^(3/2)
//
// No finite-sample skewness correction is applied.
//
//@param this Persistent AdaptiveMomentsState object.
//@returns    Current skewness, or na when variance is not positive.
export method skewness(
    AdaptiveMomentsState this
) =>

    (
        not na(this.mean)
        and this.m2 > 0.0
    )
         ? this.m3
             / (
                 this.m2
                 * math.sqrt(this.m2)
             )
         : na


//@function
// Returns raw Pearson moment kurtosis:
//
//     m4 / m2^2
//
// No finite-sample kurtosis correction is applied.
//
//@param this Persistent AdaptiveMomentsState object.
//@returns    Current Pearson kurtosis, or na when variance is not positive.
export method kurtosis(
    AdaptiveMomentsState this
) =>

    (
        not na(this.mean)
        and this.m2 > 0.0
    )
         ? this.m4
             / (
                 this.m2
                 * this.m2
             )
         : na


//@function
// Returns excess moment kurtosis:
//
//     kurtosis - 3
//
//@param this Persistent AdaptiveMomentsState object.
//@returns    Current excess kurtosis, or na when kurtosis is undefined.
export method excessKurtosis(
    AdaptiveMomentsState this
) =>

    float pearsonKurtosis =
         this.kurtosis()

    not na(pearsonKurtosis)
         ? pearsonKurtosis - 3.0
         : na


//@function
// Returns effective sample size implied by normalized-weight concentration:
//
//     Neff = 1 / weightSquareSum
//
//@param this Persistent AdaptiveMomentsState object.
//@returns    Current effective sample size, or na when empty or undefined.
export method effectiveSampleSize(
    AdaptiveMomentsState this
) =>

    (
        not na(this.mean)
        and this.weightSquareSum > 0.0
    )
         ? 1.0 / this.weightSquareSum
         : na


//@function
// Resets a persistent adaptive covariance state.
//
//@param this Persistent AdaptiveCovarianceState object.
//@returns    The reset AdaptiveCovarianceState object.
export method reset(
    AdaptiveCovarianceState this
) =>

    this.meanX := na
    this.meanY := na

    this.varianceX := 0.0
    this.varianceY := 0.0
    this.covariance := 0.0

    this.weightSquareSum := 1.0

    this


//@function
// Updates an exponentially weighted covariance/correlation state.
//
// The paired observations always share one common recursive coefficient and
// therefore one common weight population.
//
// Alpha is clamped to [0,1].
//
// Missing x, y, or alpha preserves the complete retained state.
//
// The first valid paired observation initializes both means directly,
// initializes all central moments to zero, and sets weightSquareSum to one.
//
// Alpha = 0 initializes an empty state but freezes an already active state.
//
// Alpha = 1 replaces the complete weighted population by the current single
// observation, leaving zero central moments and weightSquareSum = 1.
//
//@param this  Persistent AdaptiveCovarianceState object.
//@param x     Current X observation.
//@param y     Current Y observation.
//@param alpha Recursive weighting coefficient.
//@returns     The updated AdaptiveCovarianceState object.
export method update(
    AdaptiveCovarianceState this,
    series float x,
    series float y,
    series float alpha
) =>

    bool validObservation =
         not na(x)
         and not na(y)
         and not na(alpha)

    if validObservation

        float coefficient = clamp(
            alpha,
            0.0,
            1.0
        )

        if (
            na(this.meanX)
            or na(this.meanY)
        )

            this.meanX := x
            this.meanY := y

            this.varianceX := 0.0
            this.varianceY := 0.0
            this.covariance := 0.0

            this.weightSquareSum := 1.0

        else

            float dx =
                 x - this.meanX

            float dy =
                 y - this.meanY

            float retention =
                 1.0 - coefficient

            this.meanX +=
                 coefficient * dx

            this.meanY +=
                 coefficient * dy

            this.varianceX :=
                 retention
                 * (
                     this.varianceX
                     + coefficient
                     * dx
                     * dx
                 )

            this.varianceY :=
                 retention
                 * (
                     this.varianceY
                     + coefficient
                     * dy
                     * dy
                 )

            this.covariance :=
                 retention
                 * (
                     this.covariance
                     + coefficient
                     * dx
                     * dy
                 )

            this.weightSquareSum :=
                 retention
                 * retention
                 * this.weightSquareSum
                 + coefficient
                 * coefficient

    this


//@function
// Returns the finite-weight central-moment correction denominator:
//
//     1 - weightSquareSum
//
// A value <= 0 means a corrected central moment is undefined.
//
//@param this Persistent AdaptiveCovarianceState object.
//@returns    Current finite-weight correction denominator.
export method correctionDenominator(
    AdaptiveCovarianceState this
) =>

    1.0 - this.weightSquareSum


//@function
// Returns finite-weight corrected covariance when defined.
//
//@param this Persistent AdaptiveCovarianceState object.
//@returns    Corrected covariance, or na when undefined.
export method correctedCovariance(
    AdaptiveCovarianceState this
) =>

    float denominator =
         this.correctionDenominator()

    denominator > 0.0
         ? this.covariance / denominator
         : na


//@function
// Returns finite-weight corrected X variance when defined.
//
//@param this Persistent AdaptiveCovarianceState object.
//@returns    Corrected X variance, or na when undefined.
export method correctedVarianceX(
    AdaptiveCovarianceState this
) =>

    float denominator =
         this.correctionDenominator()

    denominator > 0.0
         ? this.varianceX / denominator
         : na


//@function
// Returns finite-weight corrected Y variance when defined.
//
//@param this Persistent AdaptiveCovarianceState object.
//@returns    Corrected Y variance, or na when undefined.
export method correctedVarianceY(
    AdaptiveCovarianceState this
) =>

    float denominator =
         this.correctionDenominator()

    denominator > 0.0
         ? this.varianceY / denominator
         : na


//@function
// Returns exponentially weighted Pearson correlation.
//
// The common finite-weight attenuation factor cancels algebraically between
// covariance and marginal variances, so no 1-weightSquareSum correction is
// applied.
//
// Correlation remains undefined while either marginal variance is zero.
//
//@param this Persistent AdaptiveCovarianceState object.
//@returns    Current correlation, or na when undefined.
export method correlation(
    AdaptiveCovarianceState this
) =>

    float denominator =
         (
             this.varianceX > 0.0
             and this.varianceY > 0.0
         )
         ? math.sqrt(
             this.varianceX
             * this.varianceY
         )
         : na

    (
        not na(denominator)
        and denominator > 0.0
    )
         ? this.covariance / denominator
         : na


//@function
// Returns the effective sample size implied by normalized-weight
// concentration:
//
//     Neff = 1 / weightSquareSum
//
//@param this Persistent AdaptiveCovarianceState object.
//@returns    Current effective sample size, or na when undefined.
export method effectiveSampleSize(
    AdaptiveCovarianceState this
) =>

    this.weightSquareSum > 0.0
         ? 1.0 / this.weightSquareSum
         : na


//@function
// Returns the exponentially weighted simple-regression slope of Y on X.
//
// For the common recursively weighted paired population:
//
//     beta = covariance / varianceX
//
// The finite-weight central-moment correction factor cancels exactly because
// covariance and varianceX share the same normalized observation weights:
//
//     correctedCovariance / correctedVarianceX
//         = covariance / varianceX
//
// Consequently no 1-weightSquareSum correction is required.
//
// The slope is undefined while X variance is zero.
//
//@param this Persistent AdaptiveCovarianceState object.
//@returns    Current regression slope of Y on X, or na when undefined.
export method betaYOnX(
    AdaptiveCovarianceState this
) =>

    this.varianceX > 0.0
         ? this.covariance
             / this.varianceX
         : na


//@function
// Returns the exponentially weighted simple-regression intercept of Y on X.
//
// Given:
//
//     beta = covariance / varianceX
//
// the intercept is:
//
//     intercept = meanY - beta * meanX
//
// The intercept is undefined whenever the regression slope is undefined.
//
//@param this Persistent AdaptiveCovarianceState object.
//@returns    Current regression intercept of Y on X, or na when undefined.
export method interceptYOnX(
    AdaptiveCovarianceState this
) =>

    float beta =
         this.betaYOnX()

    (
        not na(beta)
        and not na(this.meanX)
        and not na(this.meanY)
    )
         ? this.meanY
             - beta
             * this.meanX
         : na


//@function
// Returns the coefficient of determination for the exponentially weighted
// simple linear regression of Y on X with an intercept.
//
// For simple regression with one explanatory variable and an intercept:
//
//     R^2 = correlation^2
//
// No additional finite-weight correction is applied.
//
// Like correlation itself, the finite-effective-sample R^2 statistic may
// possess ordinary ratio-estimator bias.
//
//@param this Persistent AdaptiveCovarianceState object.
//@returns    Current coefficient of determination, or na when undefined.
export method rSquared(
    AdaptiveCovarianceState this
) =>

    float rho =
         this.correlation()

    not na(rho)
         ? rho * rho
         : na


//@function
// Updates a persistent recursively weighted Heavy-Tail distribution state.
//
// The estimator uses recursively weighted CENTRAL moments and derives:
//     • Recursive mean / location
//     • Recursive standard scale
//     • Student-t variance-equivalent scale
//     • Gaussian-equivalent absolute-innovation scale
//     • Effective bounded Student-t degrees of freedom
//     • Recursive Pearson kurtosis
//
// When degreesOfFreedom is not supplied, a Student-t degrees-of-freedom
// candidate is inferred from positive excess Pearson kurtosis:
//
//     dfRaw = 4 + 6 / (kurtosis - 3)
//
// and constrained to the supported interval [5,30].
//
// When kurtosis <= 3, no finite positive-excess-kurtosis Student-t moment
// match exists, so the estimator uses the upper supported df = 30 as its
// Gaussian-like bounded limit.
//
// When a fixed degreesOfFreedom value is supplied, that value is used instead
// and must lie within [5,30].
//
// Values outside this configured domain generate a runtime error.
//
// Missing input or feedback-factor observations do not mutate the retained
// distribution state.
//
// A coefficient of zero is a valid zero-weight observation. It preserves an
// initialized distribution exactly and does not initialize an empty state.
//
// A coefficient of one performs a full distribution replacement:
//     mean          = input
//     m2,m3,m4      = 0
//     absInnovation = 0
//
// This behavior supports exact initialization when anchored recursive processes
// are called.
//
// This is an O(1) online recursive estimator.
// It is NOT a Student-t maximum-likelihood estimator.
//
//@param this             Persistent HeavyTailState object.
//@param input            Current observation.
//@param feedbackFactor   Recursive update coefficient: 0 <= alpha <= 1.
//@param degreesOfFreedom Optional fixed Student-t degrees of freedom.
//@returns                 The current HeavyTailState object.
export method update(
    HeavyTailState this,
    series float input,
    series float feedbackFactor,
    simple float degreesOfFreedom = na
) =>

    // Configuration validation.
    if not na(degreesOfFreedom)
         and (degreesOfFreedom < MIN_STUDENT_DF
         or degreesOfFreedom > MAX_STUDENT_DF)

        runtime.error(
            "Heavy-Tail degrees of freedom must be between 5 and 30."
        )

    // Validate the current stream observation
    bool validObservation = 
         not na(input)
         and not na(feedbackFactor)

    if validObservation

        // Recursive coefficient.
        float alpha = clamp(
            feedbackFactor,
            0.0,
            1.0
        )

        if alpha > 0.0

            float beta = 1.0 - alpha

            // -------------------------------------------------------------------------
            // INITIALIZATION / CENTRAL-MOMENT RECURSION
            // -------------------------------------------------------------------------
            bool emptyPopulation = na(this.moments)

            if not emptyPopulation
                emptyPopulation := na(this.moments.mean)

            if na(this.moments)
                this.moments := AdaptiveMomentsState.new()

            if emptyPopulation or alpha >= 1.0

                this.moments.update(
                    input,
                    alpha
                )

                this.absInnovation := 0.0

            else

                // Previous distribution state.
                float oldMean          = this.moments.mean
                float oldAbsInnovation = this.absInnovation

                // Innovation around PREVIOUS location.
                float delta = input - oldMean

                this.moments.update(
                    input,
                    alpha
                )

                // Recursively weighted absolute innovation.
                this.absInnovation := beta * oldAbsInnovation
                     + alpha * math.abs(delta)

            // -------------------------------------------------------------------------
            // EMPIRICAL DISPERSION
            // -------------------------------------------------------------------------
            float variance = math.max(
                     this.moments.m2,
                     0.0
            )

            this.sigma := math.sqrt(variance)

            // -------------------------------------------------------------------------
            // PEARSON KURTOSIS
            //     K = M4 / M2²
            //
            // Gaussian reference:
            //     K = 3
            // -------------------------------------------------------------------------
            this.kurtosis := variance > MIN_FLOAT
                 ? this.moments.m4 / (variance * variance)
                 : 3.0

            // -------------------------------------------------------------------------
            // STUDENT-t KURTOSIS-IMPLIED DEGREES OF FREEDOM
            //
            // Student-t Pearson kurtosis:
            //     K = 3 + 6 / (df - 4)
            //
            // therefore:
            //     df = 4 + 6 / (K - 3)
            // -------------------------------------------------------------------------
            float dynamicDf = this.kurtosis > 3.0
                 ? 4.0 + 6.0 / (this.kurtosis - 3.0)
                 : MAX_STUDENT_DF

            float effectiveDf = na(degreesOfFreedom)
                 ? dynamicDf
                 : degreesOfFreedom

            this.df := clamp(
                effectiveDf,
                MIN_STUDENT_DF,
                MAX_STUDENT_DF
            )

            // -------------------------------------------------------------------------
            // STUDENT-t SCALE
            //
            // Student-t variance:
            //     variance = scale² * df / (df - 2)
            //
            // therefore:
            //     scale = sigma * sqrt((df - 2) / df)
            // -------------------------------------------------------------------------
            this.tScale := this.sigma > 0.0
                 ? this.sigma * math.sqrt( 
                     (this.df - 2.0) / this.df 
                 )
                 : 0.0

            // -------------------------------------------------------------------------
            // ABSOLUTE-INNOVATION SCALE
            //
            // Gaussian reference for centered innovations:
            //     sigma = E[|innovation|] * sqrt(pi / 2)
            //
            // This is a Gaussian-equivalent scale derived from recursively weighted
            // absolute innovations around the previous recursive location.
            //
            // It is a comparison scale and is NOT an exact Student-t scale estimator.
            // -------------------------------------------------------------------------
            this.absInnovationScale := this.absInnovation * MEAN_ABS_TO_SIGMA

    // Return the state whether updated or preserved.
    this


//@function
// Resets a persistent Heavy-Tail distribution state.
//
// Restores all recursive moments and derived statistics to their
// initialization values.
//
//@param this Persistent HeavyTailState object.
//@returns    The reset HeavyTailState object.
export method reset(
    HeavyTailState this
) =>

    if na(this.moments)
        this.moments := AdaptiveMomentsState.new()

    this.moments.reset()
    this.absInnovation      := 0.0
    this.sigma              := 0.0
    this.tScale             := 0.0
    this.absInnovationScale := 0.0
    this.df                 := MAX_STUDENT_DF
    this.kurtosis           := 3.0
    this


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FUNCTIONAL STREAMING INTERFACES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━


//@function
// First-order Infinite Impulse Response filter.
//
// Functional interface over IIR1State for applications where explicit
// state-object management is not required.
//
// Each written call to this function owns an independent persistent
// recursive state.
//
// Missing input or coefficient observations do not implicitly mutate the
// retained recursive state. In the absence of an explicit reset, the current
// output is na and the next valid observation resumes from the last valid
// retained state.
//
// When `feedback` is na, complementary feedback `1 - coefficient` is used.
// Consequently, na feedback does not invalidate the current observation.
//
// A coefficient of zero is valid. With complementary feedback it produces
// exact retention of an initialized recursive state.
//
// With explicitly supplied feedback, coefficient zero removes only the
// feed-forward contribution; state evolution remains determined by the
// supplied feedback coefficient.
//
// When `resetWhen` is true, the retained recursive state is cleared before
// processing the current observation. An explicit reset is authoritative
// regardless of current observation availability.
//
// If the reset observation is valid, it initializes the new recursive sequence
// according to the normal initialization rules.
//
// If the reset observation is invalid, the state remains uninitialized until
// a subsequent valid observation.
//
//@param init        Initialization value.
//@param input       Current observation.
//@param coefficient Recursive feed-forward coefficient: 0 <= coefficient <= 1.
//@param feedback    Optional explicit feedback coefficient.
//@param resetWhen   Optional condition that begins a new recursive sequence.
//                   Default false preserves continuous recursion.
//@returns            Current recursively filtered value, or na when the current
//                    observation is undefined.
export iir1pole(
    series float init,
    series float input,
    series float coefficient,
    series float feedback = na,
    series bool resetWhen = false
) =>

    var IIR1State state = IIR1State.new()

    bool validObservation =
         not na(input)
         and not na(coefficient)

    if resetWhen
        state.reset()

    state.update(
        input,
        coefficient,
        init,
        feedback
    )

    validObservation
         ? state.value
         : na


//@function
// An online O(1) extrema estimator.
//
// Functional interface over ExtremaState for applications where explicit
// state-object management is not required.
//
// Each written call to this function owns an independent persistent
// extrema state.
//
// New extrema are captured immediately while retained extrema asymptotically
// release toward subsequent observations according to the supplied recursive
// coefficient.
//
// Missing upper, lower, or coefficient observations do not implicitly mutate
// either retained extrema state. In the absence of an explicit reset, the
// current output is [na, na] and the next valid observation resumes from the
// last valid retained extrema.
//
// When `resetWhen` is true, both retained extrema states are cleared before
// processing the current observation. An explicit reset is authoritative
// regardless of current observation availability.
//
// If the reset observation is valid, its upper and lower inputs initialize
// the new extrema sequence.
//
// If the reset observation is invalid, both extrema states remain
// uninitialized until a subsequent valid observation.
//
// A coefficient of zero is valid. New extrema are still captured immediately,
// while previously retained extrema perform no asymptotic release.
//
// This is not an exact finite-window highest/lowest calculation.
//
//@param upperInput  Observation used for peak estimation.
//@param lowerInput  Observation used for trough estimation.
//@param coefficient Recursive release coefficient: 0 <= coefficient <= 1.
//@param resetWhen   Optional condition that begins a new extrema sequence.
//                   Default false preserves continuous recursion.
//@returns            Tuple [peak, trough], or [na, na] when the current
//                    observation is undefined.
export extrema(
    series float upperInput,
    series float lowerInput,
    series float coefficient,
    series bool resetWhen = false
) =>

    var ExtremaState state = ExtremaState.new()

    bool validObservation =
         not na(upperInput)
         and not na(lowerInput)
         and not na(coefficient)

    if resetWhen
        state.reset()

    state.update(
        upperInput,
        lowerInput,
        coefficient
    )

    [ validObservation ? state.peak   : na, 
      validObservation ? state.trough : na ]


//@function
// Estimates one predefined quantile of a cumulative observation population
// using the fixed-memory P² dynamic quantile estimator.
//
// P² maintains five marker heights and their corresponding actual and desired
// population positions. It approximates the requested quantile without
// retaining or sorting the complete observation history.
//
// The estimator requires five valid observations to initialize. Until the
// bootstrap population is complete, the returned quantile is na.
//
// Each written call to this function owns an independent persistent
// P2QuantileState.
//
// The requested `probability` defines one fixed quantile population:
//
//     0 < probability < 1
//
// Changing probability within an active state population is structurally
// invalid. The functional interface therefore requires a simple probability
// configuration.
//
// Missing input observations do not mutate the retained P² state. In the
// absence of an explicit reset, the current output is na and the next valid
// observation resumes the existing population.
//
// When `resetWhen` is true, the previous quantile population is discarded
// before processing the current observation.
//
// If the reset observation is valid, it becomes the first bootstrap
// observation of the new population.
//
// If the reset observation is missing, the new population remains empty until
// a subsequent valid observation.
//
// This estimator is approximate. It is not an exact nearest-rank or
// finite-window percentile calculation.
//
// Computational complexity is O(1) per valid observation and retained storage
// is O(1) with respect to population length.
//
// Algorithmic foundation:
//     Jain, R. and Chlamtac, I. (1985).
//     "The P² Algorithm for Dynamic Calculation of Quantiles and Histograms
//     Without Storing Observations."
//     Communications of the ACM 28(10), 1076-1085.
//     DOI: 10.1145/4372.4378
//
// This implementation also incorporates numerical and initialization
// refinements analyzed by Andrey Akinshin, including direct desired-position
// reconstruction, adaptive initialization, and probability-dependent interior
// marker adjustment order.
//
// The desired-position reconstruction addresses a numerical issue reported
// by Anthony Lloyd and subsequently analyzed by Akinshin.
//
//@param input       Current observation.
//@param probability Predefined quantile probability: 0 < probability < 1.
//@param resetWhen   Optional condition that begins a new quantile population.
//                   Default false preserves the cumulative population.
//@returns            Current approximate P² quantile, or na while the bootstrap
//                    population is incomplete or the current input is missing.
export p2Quantile(
    series float input,
    simple float probability,
    series bool resetWhen = false
) =>

    var P2QuantileState state =
         P2QuantileState.new()

    bool validObservation =
         not na(input)

    if resetWhen
        state.reset()

    state.update(
        input,
        probability
    )

    validObservation
         ? state.value
         : na


//@function
// Recursively tracks a quantile of an adapting population.
//
// Uses a quantile-score recursion whose dimensioned update step is derived
// internally from the supplied dimensionless alpha and the previously retained
// absolute-innovation scale.
//
// Unlike p2Quantile(), this function does not estimate the cumulative empirical
// quantile of all observations since initialization. It is a recursive tracker
// whose responsiveness is controlled by alpha.
//
// Missing input or alpha preserves the active state and returns na. An explicit
// reset is authoritative before processing the current observation.
//
//@param input       Observation used to update the recursive estimator.
//@param probability Quantile probability strictly between zero and one.
//@param alpha       Dimensionless recursive adaptation coefficient.
//@param resetWhen   When true, discards the previous state before processing
//                   the current observation.
//@returns           Recursively tracked quantile estimate, or na when the
//                   current observation cannot be processed.
export adaptiveQuantile(
    series float input,
    simple float probability,
    series float alpha,
    series bool resetWhen = false
) =>
    var AdaptiveQuantileState state =
         AdaptiveQuantileState.new()

    bool validObservation =
         not na(input)
         and not na(alpha)

    if resetWhen
        state.reset()

    state.update(
        input,
        probability,
        alpha
    )

    validObservation
         ? state.value
         : na


//@function
// Recursively tracks an expectile of an adapting population.
//
// Uses an asymmetric least-squares recursion. For retained estimate e and
// current observation x:
//
//     innovation = x - e
//
//     e += alpha * level       * innovation    when innovation > 0
//     e += alpha * (1 - level) * innovation    when innovation < 0
//
// Consequently, alpha is a baseline adaptation coefficient rather than one
// fixed EMA-equivalent gain. Effective responsiveness depends on both the
// expectile level and the sign of the current innovation.
//
// Levels below 0.5 respond more strongly downward than upward.
//
// Levels above 0.5 respond more strongly upward than downward.
//
// At level = 0.5, the asymmetric squared-loss target becomes the ordinary
// location mean. Under this recursion the effective correction coefficient is
// alpha / 2.
//
// Unlike adaptiveQuantile(), this estimator requires no internally retained
// innovation scale because the correction is directly proportional to the
// dimensioned innovation.
//
// Missing input or alpha preserves the active state and returns na. An explicit
// reset is authoritative before processing the current observation.
//
//@param input     Observation used to update the recursive estimator.
//@param level     Expectile level strictly between zero and one.
//@param alpha     Baseline dimensionless recursive adaptation coefficient.
//@param resetWhen When true, discards the previous state before processing
//                 the current observation.
//@returns         Recursively tracked expectile estimate, or na when the
//                 current observation cannot be processed.
export adaptiveExpectile(
    series float input,
    simple float level,
    series float alpha,
    series bool resetWhen = false
) =>

    var AdaptiveExpectileState state =
         AdaptiveExpectileState.new()

    bool validObservation =
         not na(input)
         and not na(alpha)

    if resetWhen
        state.reset()

    state.update(
        input,
        level,
        alpha
    )

    validObservation
         ? state.value
         : na


//@function
// Recursively tracks an exponentially weighted conditional tail mean.
//
// The caller supplies the current tail threshold explicitly.
//
// Lower-tail membership:
//
//     input <= threshold
//
// Upper-tail membership:
//
//     input >= threshold
//
// Internally, tail-value contribution and tail-membership mass are recursively
// decayed on the ordinary observation clock and the reported tail mean is their
// normalized ratio.
//
// Unlike an event-clock average that updates only on tail observations, every
// valid positive-weight observation advances the recursive population.
//
// Non-tail observations decay numerator and denominator identically and
// therefore preserve an already-defined normalized conditional mean.
//
// The threshold may vary through time. In particular, callers may supply a
// quantile or another recursively estimated boundary.
//
// When using an adaptive quantile threshold, threshold timing belongs to the
// caller. Statistical validation of this library architecture uses the
// quantile retained BEFORE the current observation as the current tail
// threshold.
//
// TailSide is fixed for the active state and may change only after reset.
//
// Missing input, threshold, or alpha preserves the active state and returns na.
//
// Alpha is clamped to [0,1]. A zero alpha is a valid zero-weight observation.
//
// An explicit reset is authoritative before processing the current observation.
//
//@param input     Current observation.
//@param threshold Current external tail-membership threshold.
//@param alpha     Observation-clock recursive coefficient.
//@param side      Fixed selected TailSide.
//@param resetWhen When true, discards the previous tail state before processing
//                 the current observation.
//@returns         Current conditional tail-mean estimate, or na when the current
//                 observation cannot produce a defined output.
export adaptiveTailMean(
    series float input,
    series float threshold,
    series float alpha,
    simple TailSide side,
    series bool resetWhen = false
) =>

    var AdaptiveTailMeanState state =
         AdaptiveTailMeanState.new()

    bool validObservation =
         not na(input)
         and not na(threshold)
         and not na(alpha)

    if resetWhen
        state.reset()

    state.update(
        input,
        threshold,
        alpha,
        side
    )

    validObservation
         ? state.value
         : na


//@function
// Recursively tracks a robust Huber location.
//
// For retained location m:
//
//     innovation = input - m
//
//     limit = tuning * scale
//
//     correction = clamp(
//         innovation,
//         -limit,
//         +limit
//     )
//
//     m += alpha * correction
//
// Inside the clipping region the estimator is exactly equivalent to an
// ordinary first-order IIR update using alpha.
//
// Outside the clipping region, the magnitude of one update is bounded by:
//
//     alpha * tuning * scale
//
// Scale is supplied externally and may vary through time. This function does
// not estimate dispersion internally.
//
// Tuning is fixed for the active state and may change only after reset.
//
// Alpha is the literal recursive update coefficient and is clamped to [0,1].
// Tuning-dependent bandwidth normalization is deliberately not performed.
//
// Missing input, scale, or alpha preserves the active state and returns na.
//
// A zero scale is valid and freezes an already initialized location.
//
// An explicit reset is authoritative before processing the current
// observation.
//
//@param input     Current observation.
//@param scale     Current external non-negative scale in input units.
//@param tuning    Fixed positive dimensionless Huber clipping constant.
//@param alpha     Recursive update coefficient.
//@param resetWhen When true, discards the previous state before processing
//                 the current observation.
//@returns         Current recursively tracked robust location, or na when the
//                 current observation cannot be processed.
export adaptiveHuber(
    series float input,
    series float scale,
    simple float tuning,
    series float alpha,
    series bool resetWhen = false
) =>

    var AdaptiveHuberState state =
         AdaptiveHuberState.new()

    bool validObservation =
         not na(input)
         and not na(scale)
         and not na(alpha)

    if resetWhen
        state.reset()

    state.update(
        input,
        scale,
        tuning,
        alpha
    )

    validObservation
         ? state.value
         : na


//@function
// Fixed-memory approximate cumulative-population median using P².
// The estimate is undefined until five valid observations initialize
// the estimator. Missing observations preserve the active population.
//@param input Observation used to update the cumulative population.
//@param resetWhen When true, discards the previous population before
// processing the current observation.
//@returns Approximate cumulative-population median, or na when undefined.
export median(
    series float input,
    series bool resetWhen = false
) =>
    p2Quantile(
        input,
        0.5,
        resetWhen
    )


//@function
// Recursively tracks the median of an adapting population.
//
// This is equivalent to adaptiveQuantile(input, 0.5, alpha, resetWhen).
//
// Unlike median(), this function does not represent the cumulative median of
// all observations since initialization. Its responsiveness is controlled by
// the supplied dimensionless alpha.
//
// Missing input or alpha preserves the active state and returns na.
//
//@param input     Observation used to update the recursive estimator.
//@param alpha     Dimensionless recursive adaptation coefficient.
//@param resetWhen When true, discards the previous state before processing
//                 the current observation.
//@returns         Recursively tracked median estimate, or na when the current
//                 observation cannot be processed.
export adaptiveMedian(
    series float input,
    series float alpha,
    series bool resetWhen = false
) =>
    adaptiveQuantile(
        input,
        0.5,
        alpha,
        resetWhen
    )


//@function
// Recursively tracks the median absolute deviation around an externally
// supplied center.
//
// For current observation x and external center m:
//
//     deviation = abs(x - m)
//
// The returned value is the adaptive median of the deviation stream:
//
//     MAD = adaptiveMedian(
//         abs(input - center),
//         alpha
//     )
//
// The center is deliberately external and may vary from observation to
// observation.
//
// This function does not update or own the center estimator.
//
// When composing MAD with another recursive location estimator, the current
// deviation should normally be formed from the location retained BEFORE the
// current observation is allowed to update that location.
//
// For example:
//
//     previousCenter = location
//
//     mad = adaptiveMAD(
//         input,
//         previousCenter,
//         madAlpha
//     )
//
// The returned value is the raw median absolute deviation in input units.
//
// No Gaussian conversion is applied internally.
//
// Missing input, center, or alpha preserves the underlying adaptive-median
// state and returns na.
//
// Alpha semantics are exactly those of adaptiveMedian() / adaptiveQuantile().
//
// An explicit reset is authoritative before processing the current
// observation.
//
//@param input     Current observation.
//@param center    Current external location used to form absolute deviation.
//@param alpha     Recursive adaptive-median coefficient.
//@param resetWhen When true, resets the retained MAD state before processing
//                 the current observation.
//@returns         Current raw adaptive median absolute deviation.
export adaptiveMAD(
    series float input,
    series float center,
    series float alpha,
    series bool resetWhen = false
) =>

    bool validObservation =
         not na(input)
         and not na(center)
         and not na(alpha)

    float deviation =
         validObservation
         ? math.abs(
             input - center
         )
         : na

    adaptiveMedian(
        deviation,
        alpha,
        resetWhen
    )


//@function
// Recursively tracks covariance between paired series.
//
// When corrected = true, returns:
//
//     rawCovariance
//     / (1 - weightSquareSum)
//
// when that correction is defined.
//
// When corrected = false, returns the raw exponentially weighted population
// covariance.
//
// Under an IID paired-observation population, the finite-weight correction
// has its usual unbiased-expectation interpretation when recursive weights
// are deterministic or otherwise independent of the paired observations.
//
// Alpha is clamped to [0,1].
//
// Missing x, y, or alpha preserves retained state and returns na.
//
// Reset occurs before processing the current paired observation.
//
//@param x         Current X observation.
//@param y         Current Y observation.
//@param alpha     Recursive weighting coefficient.
//@param corrected When true, returns finite-weight corrected covariance.
//@param resetWhen When true, resets retained state before the current pair.
//@returns         Current covariance, or na when unavailable.
export adaptiveCovariance(
    series float x,
    series float y,
    series float alpha,
    simple bool corrected = true,
    series bool resetWhen = false
) =>

    var AdaptiveCovarianceState state =
         AdaptiveCovarianceState.new()

    bool validObservation =
         not na(x)
         and not na(y)
         and not na(alpha)

    if resetWhen
        state.reset()

    state.update(
        x,
        y,
        alpha
    )

    if not validObservation

        na

    else if corrected

        state.correctedCovariance()

    else

        state.covariance


//@function
// Recursively tracks exponentially weighted Pearson correlation between two
// paired series.
//
// Covariance and marginal variances are maintained using exactly the same
// exponentially weighted observation population.
//
// The common finite-weight attenuation factor cancels from the correlation
// ratio, so no covariance-style correction is applied.
//
// Correlation is undefined until both marginal variances are positive.
//
// Alpha is clamped to [0,1].
//
// Missing x, y, or alpha preserves retained state and returns na.
//
// Reset occurs before processing the current paired observation.
//
//@param x         Current X observation.
//@param y         Current Y observation.
//@param alpha     Recursive weighting coefficient.
//@param resetWhen When true, resets retained state before the current pair.
//@returns         Current correlation, or na when undefined.
export adaptiveCorrelation(
    series float x,
    series float y,
    series float alpha,
    series bool resetWhen = false
) =>

    var AdaptiveCovarianceState state =
         AdaptiveCovarianceState.new()

    bool validObservation =
         not na(x)
         and not na(y)
         and not na(alpha)

    if resetWhen
        state.reset()

    state.update(
        x,
        y,
        alpha
    )

    validObservation
         ? state.correlation()
         : na


//@function
// Recursively tracks the exponentially weighted simple-regression slope of
// Y on X.
//
// The regression slope is derived from the same paired recursive population:
//
//     beta = covariance(X,Y) / variance(X)
//
// Because covariance and variance use identical normalized observation
// weights, their common finite-weight attenuation factor cancels.
//
// Alpha is clamped to [0,1] by the underlying AdaptiveCovarianceState.
//
// Missing x, y, or alpha preserves retained state and returns na.
//
// Reset occurs before processing the current paired observation.
//
//@param x         Current explanatory-variable observation.
//@param y         Current dependent-variable observation.
//@param alpha     Recursive weighting coefficient.
//@param resetWhen When true, resets retained paired state before the current
//                 observation.
//@returns         Current regression beta of Y on X, or na when undefined.
export adaptiveBeta(
    series float x,
    series float y,
    series float alpha,
    series bool resetWhen = false
) =>

    var AdaptiveCovarianceState state =
         AdaptiveCovarianceState.new()

    bool validObservation =
         not na(x)
         and not na(y)
         and not na(alpha)

    if resetWhen
        state.reset()

    state.update(
        x,
        y,
        alpha
    )

    validObservation
         ? state.betaYOnX()
         : na


//@function
// Recursively tracks exponentially weighted simple linear regression of
// Y on X.
//
// The retained paired population provides:
//
//     beta = covariance / varianceX
//
//     intercept = meanY - beta * meanX
//
//     R^2 = correlation^2
//
// No separate regression recursion is maintained. All regression quantities
// are algebraic views of one AdaptiveCovarianceState population.
//
// The common finite-weight correction applied to covariance and variance
// cancels exactly from beta.
//
// Alpha is clamped to [0,1] by the underlying covariance state.
//
// Missing x, y, or alpha preserves retained state and returns na outputs.
//
// Reset occurs before processing the current paired observation.
//
//@param x         Current explanatory-variable observation.
//@param y         Current dependent-variable observation.
//@param alpha     Recursive weighting coefficient.
//@param resetWhen When true, resets retained paired state before the current
//                 observation.
//@returns         Tuple [beta, intercept, rSquared], with na components while
//                 regression is undefined or the current pair is unavailable.
export adaptiveLinearRegression(
    series float x,
    series float y,
    series float alpha,
    series bool resetWhen = false
) =>

    var AdaptiveCovarianceState state =
         AdaptiveCovarianceState.new()

    bool validObservation =
         not na(x)
         and not na(y)
         and not na(alpha)

    if resetWhen
        state.reset()

    state.update(
        x,
        y,
        alpha
    )

    float beta =
         validObservation
         ? state.betaYOnX()
         : na

    float intercept =
         validObservation
         ? state.interceptYOnX()
         : na

    float rSquared =
         validObservation
         ? state.rSquared()
         : na

    [ beta,
      intercept,
      rSquared ]


//@function
// An online Heavy-Tail distribution estimator.
//
// Functional interface over HeavyTailState for applications where explicit
// state-object management is not required.
//
// Each written call to this function owns an independent persistent
// HeavyTailState.
//
// The estimator uses recursively weighted CENTRAL moments and derives:
//     • Recursive mean / location
//     • Recursive standard scale
//     • Student-t variance-equivalent scale
//     • Gaussian-equivalent absolute-innovation scale
//     • Effective bounded Student-t degrees of freedom
//     • Recursive Pearson kurtosis
//
// When degreesOfFreedom is not supplied, a Student-t degrees-of-freedom
// candidate is inferred from positive excess Pearson kurtosis:
//
//     dfRaw = 4 + 6 / (kurtosis - 3)
//
// and constrained to the supported interval [5,30].
//
// When kurtosis <= 3, no finite positive-excess-kurtosis Student-t moment
// match exists, so the estimator uses the upper supported df = 30 as its
// Gaussian-like bounded limit.
//
// When a fixed degreesOfFreedom value is supplied, that value is used instead
// and must lie within [5,30].
//
// Missing input or feedback-factor observations do not implicitly mutate the
// retained distribution state. In the absence of an explicit reset, the
// current outputs are na and the next valid positive-weight observation
// resumes from the last valid retained distribution.
//
// When `resetWhen` is true, the retained distribution state is cleared before
// processing the current observation. An explicit reset is authoritative
// regardless of current observation availability.
//
// If the reset observation is valid and has positive recursive weight, it
// initializes the new distribution according to the normal update rules.
//
// If the reset observation is invalid or has zero recursive weight, the
// distribution remains uninitialized until a subsequent valid positive-weight
// observation.
//
// A coefficient of zero is a valid zero-weight observation. It preserves an
// initialized distribution exactly and does not initialize an empty state.
//
// A coefficient of one performs a full distribution replacement:
//     mean          = input
//     m2,m3,m4      = 0
//     absInnovation = 0
//
// This behavior supports exact initialization of anchored recursive processes.
//
// This is an O(1) online recursive estimator.
// It is NOT a Student-t maximum-likelihood estimator.
//
//@param input             Current observation.
//@param feedbackFactor    Recursive update coefficient: 0 <= alpha <= 1.
//@param degreesOfFreedom  Optional fixed Student-t degrees of freedom.
//@param resetWhen         Optional condition that begins a new distribution
//                         sequence. Default false preserves continuous recursion.
//@returns                 Tuple:
//                         [mean, sigma, tScale, absInnovationScale, df, kurtosis].
//                         Returns na components when the current observation
//                         cannot produce a valid distribution estimate.
export heavyTailDistribution(
    series float input,
    series float feedbackFactor = 0.1,
    simple float degreesOfFreedom = na,
    series bool  resetWhen = false
) =>

    var HeavyTailState state = HeavyTailState.new()

    bool validObservation =
         not na(input)
         and not na(feedbackFactor)

    if resetWhen
        state.reset()

    state.update(
        input,
        feedbackFactor,
        degreesOfFreedom
    )

    float stateMean = na

    if not na(state.moments)
        stateMean := state.moments.mean

    bool hasEstimate =
         validObservation
         and not na(stateMean)

    [ hasEstimate ? stateMean         : na,
      hasEstimate ? state.sigma       : na, 
      hasEstimate ? state.tScale      : na,
      hasEstimate ? state.absInnovationScale : na,
      hasEstimate ? state.df          : na,
      hasEstimate ? state.kurtosis    : na ]


//@function
// O(1) sample-and-hold estimator.
//
// Functional interface over SampleHoldState for applications where explicit
// state-object management is not required.
//
// Each written call to this function owns an independent persistent
// sampled state.
//
// When `resetWhen` is true, the retained sampled state is cleared before
// processing the current observation. An explicit reset is authoritative
// regardless of current observation availability.
//
// If the reset observation is valid and `sampleWhen` is true, it immediately
// becomes the first sampled value of the new sequence.
//
// Otherwise the state remains uninitialized until a subsequent valid sample.
//
//@param input      Observation available for sampling.
//@param sampleWhen Condition that causes the current observation to be retained.
//@param resetWhen  Optional condition that begins a new sampled sequence.
//                  Default false preserves the retained sampled state.
//@returns           Most recently sampled observation, or na before first sample.
export sampleHold(
    series float input,
    series bool sampleWhen,
    series bool resetWhen = false
) =>

    var SampleHoldState state = SampleHoldState.new()

    if resetWhen
        state.reset()

    state.update(
        input,
        sampleWhen
    )

    state.value


//@function
// Preserves the final developing value whenever a supplied condition
// begins a new observation sequence.
//
// The settleWhen itself is generic. It may represent a timeframe change,
// session boundary, custom event, or any other caller-defined condition.
//
// When `resetWhen` is true, both developing and settled state are cleared
// before processing the current observation. An explicit reset is authoritative
// regardless of current observation availability.
//
// If `resetWhen` and `settleWhen` are both true, no value from the previous
// sequence is settled. The current input instead begins the new developing
// sequence.
//
//@param input      Current developing observation.
//@param settleWhen Condition that settles the previous developing value.
//@param resetWhen  Optional condition that begins a new settlement sequence.
//                  Default false preserves continuous settlement state.
//@returns           Most recently settled value, or na before first settlement.
export settledValueWhen(
    series float input,
    series bool settleWhen,
    series bool resetWhen = false
) =>

    var SettlementState state = SettlementState.new()

    if resetWhen
        state.reset()

    state.update(
        input,
        settleWhen
    )

    state.settled


//@function
// Maintains a cumulative sum of valid observations.
//
// Functional interface over AccumulatorState for applications where explicit
// state-object management is not required.
//
// Each written call owns an independent persistent accumulation state.
//
// When `resetWhen` is true, the current observation begins a new cumulative
// sequence. Otherwise, every valid observation is added to the retained sum.
//
// Missing observations are ignored between resets. If a reset occurs while
// the input is na, the new cumulative sequence remains uninitialized until
// its first valid observation.
//
//@param input     Current observation to accumulate.
//@param resetWhen Optional condition that begins a new cumulative sequence.
//                 Default false preserves continuous accumulation.
//@returns         Current cumulative value, or na before the first valid input.
export cum(
    series float input,
    series bool resetWhen = false
) =>

    var AccumulatorState state = AccumulatorState.new()

    state.update(
        input,
        resetWhen
    )

    state.value


//@function
// Maintains the exact sum of the last N observations.
//
// The rolling update is:
//     sum[t] = sum[t-1] + input[t] - input[t-N]
//
// The operation performs O(1) arithmetic per observation while using the host
// data series to address the observation leaving the finite population.
//
// The result becomes defined only after N observations have populated the
// rolling window.
//
// Every observation retains membership in the rolling population. Missing
// inputs are not skipped or interpreted as zero. If any observation within
// the active N-observation population is missing, the current output is na.
//
// Unlike recursive estimators with fixed retained state, an exact rolling
// population requires access to the observation leaving the N-element window.
// The host data series provides that historical addressing.
//
// No explicit reset condition is provided because population membership is
// defined solely by the most recent N processing observations.
//
//@param input Current additive observation.
//@param span  Positive number N of observations in the rolling population.
//@returns      Exact sum of the last N observations, or na while the population
//              is incomplete or contains missing observations.
export rollingSum(
    series float input,
    simple int span
) =>

    if span <= 0
        runtime.error(
            "Rolling-sum span must be greater than zero."
        )

    var float rollingTotal = 0.0
    var int missingCount = 0
    var int observationCount = 0

    float contribution = nz(
        input,
        0.0
    )

    int currentMissing = na(input)
         ? 1
         : 0

    rollingTotal := rollingTotal
         + contribution
         - nz(input[span], 0.0)

    missingCount := missingCount
         + currentMissing
         - nz(currentMissing[span], 0)

    observationCount += 1

    bool windowReady =
         observationCount >= span

    bool windowValid =
         windowReady
         and missingCount == 0

    windowValid
         ? rollingTotal
         : na


//@function
// Maintains the exact sum of the last N sampled observations.
//
// The rolling population advances only when `sampleWhen` is true.
//
// Each sampled observation enters a finite N-element population while the
// oldest retained observation leaves it. The operation therefore performs
// O(1) arithmetic per sampled observation.
//
// Exact finite-observation semantics require retaining the N observations
// needed to identify the member leaving the rolling population.
//
// Missing sampled inputs retain membership in the population. They are not
// skipped or interpreted as zero. If any sampled observation within the
// active population is missing, the output is na until that observation leaves
// the rolling population.
//
// Between sampling conditions, the retained rolling state is held unchanged.
//
// No explicit reset condition is provided because population membership is
// defined solely by the most recent N sampled observations.
//
//@param input      Observation available for sampling.
//@param sampleWhen Condition that advances the rolling population.
//@param span       Positive number N of sampled observations.
//@returns           Exact sum of the last N sampled observations, or na while
//                   the population is incomplete or contains missing inputs.
export rollingSumWhen(
    series float input,
    series bool sampleWhen,
    simple int span
) =>

    if span <= 0
        runtime.error(
            "Rolling-sum span must be greater than zero."
        )

    var array<float> buffer = array.new_float(
        span,
        na
    )

    var int head = 0
    var int observationCount = 0
    var int missingCount = 0
    var float rollingTotal = 0.0

    if sampleWhen

        float outgoing = array.get(
            buffer,
            head
        )

        if observationCount >= span

            if na(outgoing)
                missingCount -= 1
            else
                rollingTotal -= outgoing

        else
            observationCount += 1

        array.set(
            buffer,
            head,
            input
        )

        if na(input)
            missingCount += 1
        else
            rollingTotal += input

        head := (head + 1) % span

    bool windowReady =
         observationCount >= span

    bool windowValid =
         windowReady
         and missingCount == 0

    windowValid
         ? rollingTotal
         : na


//@function
// Accumulates a strict observation population and returns the sum of the
// previous completed population.
//
// When `settleWhen` is true, the population preceding the current observation
// becomes settled and the current observation begins a new developing
// population.
//
// Every observation retains membership in its population. Missing inputs are
// not skipped or interpreted as zero. If any input belonging to a completed
// population is missing, that population settles as na.
//
// The most recently valid or invalid settled result is held until the next
// population completes.
//
// When `sampleWhen` is false, the developing population is not advanced.
//
// When `resetWhen` is true, all developing and settled population state is
// cleared before processing the current observation.
//
// This is an O(1) online stream composition.
//
//@param input      Current additive observation.
//@param settleWhen Condition that completes the previous population and begins
//                   a new one.
//@param resetWhen  Optional condition that clears all developing and settled
//                   population state. Default false.
//@param sampleWhen Optional condition that advances the developing population.
//                   Default true processes every observation.
//@returns           Sum of the previous completed population, or na before the
//                   first settlement or when that population contained missing
//                   observations.
export settledSumWhen(
    series float input,
    series bool settleWhen,
    series bool resetWhen = false,
    series bool sampleWhen = true
) =>

    var AccumulatorState totalState = AccumulatorState.new()
    var AccumulatorState missingState = AccumulatorState.new()

    var SettlementState totalSettlement = SettlementState.new()
    var SettlementState missingSettlement = SettlementState.new()

    float contribution = not na(input)
         ? input
         : 0.0

    float missingContribution = na(input)
         ? 1.0
         : 0.0

    if resetWhen
        totalState.reset()
        missingState.reset()
        totalSettlement.reset()
        missingSettlement.reset()

    if sampleWhen

        totalState.update(
            contribution,
            settleWhen
        )

        missingState.update(
            missingContribution,
            settleWhen
        )

        totalSettlement.update(
            totalState.value,
            settleWhen
        )

        missingSettlement.update(
            missingState.value,
            settleWhen
        )

    bool validSettledPopulation =
         not na(totalSettlement.settled)
         and not na(missingSettlement.settled)
         and missingSettlement.settled == 0.0

    validSettledPopulation
         ? totalSettlement.settled
         : na


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RECURSIVE COEFFICIENT CONSTRUCTORS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━


//@function
// Constructs a fixed recursive coefficient from a selected recursive-decay model
// and positive horizon parameter N.
//
// The returned coefficient expresses the selected decay interpretation as
// an online first-order recursive update coefficient.
//
//@param model Selected DecayModel
//@param span  Positive horizon parameter N
//@returns     Recursive alpha constrained to [0,1]
export decayAlpha(
    simple DecayModel model,
    simple int span
) =>

    // Configuration validation
    if span <= 0 
        runtime.error(
            "Decay span must be greater than zero."
        )

    float n = float(span)

    float alpha = switch model

        DecayModel.bypass =>
            0.0

        DecayModel.reciprocal =>
            1.0 / n

        DecayModel.exponential =>
            2.0 / (n + 1.0)

        DecayModel.eFold =>
            1.0 - math.exp(-1.0 / n)

        DecayModel.halfLife =>
            1.0 - math.pow(0.5, 1.0 / n)

        DecayModel.decay25 =>
            1.0 - math.pow(0.75, 1.0 / n)

        DecayModel.decay75 =>
            1.0 - math.pow(0.25, 1.0 / n)

        DecayModel.decay95 =>
            1.0 - math.pow(0.05, 1.0 / n)

    clamp( alpha,
           0.0,
           1.0 
    )


//@function
// Constructs an anchored recursive coefficient from a non-negative
// contribution stream.
//
// The current contribution is normalized by the cumulative contribution
// observed since the latest anchor:
//     alpha = input / cumulativeInput
//
// where:
//     cumulativeInput = sum(input) since anchor
//
// The first valid positive observation after an anchor produces alpha = 1.
//
// This operation converts arbitrary non-negative contribution streams into
// exact anchored normalized recursive coefficients using O(1) state.
//
// Missing or negative inputs do not contribute to the retained cumulative state
// and return na for the current observation.
//
// An explicit anchor remains authoritative. If `anchorWhen` is true while the
// current contribution is missing or negative, the previous cumulative state
// is discarded and the new sequence remains uninitialized.
//
// A zero contribution is valid. It produces alpha = 0 once the cumulative
// contribution is positive. A non-positive cumulative contribution returns na.
//
// The caller is responsible for transforming signed observations into an
// appropriate non-negative magnitude or directional contribution.
//
//@param input      Current non-negative contribution.
//@param anchorWhen Condition that begins a new accumulation sequence.
//@returns      Anchored alpha in [0,1], or na when undefined.
export anchoredAlpha(
    series float input,
    series bool anchorWhen
) =>

    var AccumulatorState state = AccumulatorState.new()

    float contribution = not na(input) and input >= 0.0
         ? input
         : na
    state.update(
        contribution,
        anchorWhen
    )

    float alpha = not na(contribution)
         and not na(state.value)
         and state.value > 0.0
             ? contribution / state.value
             : na
    na(alpha)
         ? na
         : clamp( alpha, 
                  0.0,
                  1.0
         )


//@function
// Combines two alpha-like recursive update contributions in
// complementary retention space.
//
//     alphaComposite = 1 - (1-alphaA)(1-alphaB)
//
// Alpha = 0 is the identity / no-contribution element.
//
// Missing component coefficients return na. Missing data is not implicitly
// interpreted as the alpha-space identity.
//
// Callers that deliberately want a missing contribution to behave as zero must
// apply that fallback before calling this function.
//
//@param alphaA First recursive update contribution.
//@param alphaB Second recursive update contribution.
//@returns       Composite alpha constrained to [0,1].
export compositeAlpha(
    series float alphaA,
    series float alphaB
) =>

    float a = clamp(
        alphaA,
        0.0,
        1.0
    )

    float b = clamp(
        alphaB,
        0.0,
        1.0
    )

    1.0 - (1.0 - a) * (1.0 - b)


//@function
// Constructs an alpha-like market-participation coefficient.
//
// Participation models describe the relative contribution of the current
// processing observation using traded volume or another participation measure.
//
// Model semantics:
//     none
//         Alpha-space identity.
//         alpha = 0.
//
//     equal
//         Uniform participation.
//         alpha = 1 / N.
//
//     rollingVolume
//         Current processing-domain volume relative to the exact rolling total
//         of the most recent N processing observations, including the current
//         observation.
//
//     minuteVolume
//     hourlyVolume
//     dailyVolume
//     weeklyVolume
//     monthlyVolume
//         Current processing-domain volume relative to a settled volume
//         population constructed in the selected reference domain.
//
//         These explicit time-domain models support two alternative continuity
//         policies, orthogonal to the selected reference domain and selected
//         by `elapsedTime`:
//
//             elapsedTime = false
//                 Observation continuity.
//
//                 N counts confirmed observations in the selected native
//                 reference domain. Missing clock periods do not consume
//                 members of the N-observation population.
//
//             elapsedTime = true
//                 Elapsed/calendar continuity.
//
//                 N counts consecutive reference-domain time positions.
//                 Periods without observations retain their temporal position
//                 and may therefore invalidate an otherwise complete reference
//                 population.
//
//         The denominator exposed to the participation ratio is always a
//         previous completed or confirmed reference population. Developing
//         reference-domain volume is never used as the denominator.
//
//     openInterest
//         Current traded volume relative to the latest available reported
//         end-of-day Open Interest.
//
//     floatTurnover
//         Current traded volume relative to the latest available reported
//         Float Shares Outstanding.
//
//     fundTurnover
//         Current traded fund units relative to the latest available
//         AUM/NAV-implied outstanding fund-unit population.
//
// Missing-data semantics:
//
//     Required market data that is unavailable returns na.
//
//     Dynamically undefined participation relationships return na. In
//     particular, an elapsed-time reference population may become undefined
//     after one or more complete time populations contain no usable
//     observations.
//
//     Missing-data fallback policy is deliberately delegated to the caller.
//     This function does not implicitly hold a stale denominator, substitute
//     zero, reset caller state, or manufacture a participation coefficient.
//
//     Structural model configurations that cannot be represented exactly by
//     the current processing/reference-timeframe relationship may generate a
//     runtime error.
//
// Rolling-volume population semantics:
//
//     The rolling population becomes defined only after N processing
//     observations are available.
//
//     Missing observations retain membership in the N-observation horizon;
//     they are not skipped or interpreted as zero volume. A missing member
//     therefore invalidates the active rolling population until it leaves.
//
// Reference-domain population semantics:
//
//     Observation continuity:
//
//         N = number of confirmed native-domain observations.
//
//     Elapsed/calendar continuity:
//
//         N = number of consecutive native-domain time positions.
//
//     In both cases, current processing-domain volume is compared only with a
//     settled or confirmed reference population.
//
// The resulting coefficient is constrained to [0,1]. Ratios greater than one
// therefore represent full current-observation assimilation after clamping.
//
//@param model Selected ParticipationModel.
//@param symbol TradingView symbol used for participation data.
//              Empty string uses the current chart symbol.
//@param span Positive horizon parameter N.
//             Its interpretation depends on the selected model and continuity
//             policy; it is a model horizon, not a TradingView timeframe
//             multiplier.
//@param elapsedTime Optional continuity policy for explicit time-domain models.
//                   When false, N counts confirmed observations in the selected
//                   reference domain. When true, N counts consecutive
//                   elapsed/calendar units in that domain. This parameter does
//                   not alter none, equal, rollingVolume, openInterest,
//                   floatTurnover, or fundTurnover. Default false.
//@returns Participation alpha constrained to [0,1], or na when the required
//         participation relationship is dynamically undefined.
export participationAlpha(
    simple ParticipationModel model,
    simple string symbol = "",
    simple int span = 1,
    simple bool elapsedTime = false
) =>

    // Configuration Validation
    if span <= 0 
        runtime.error(
            "Participation span must be greater than zero."
        )

    // -------------------------------------------------------------------------
    // INITIALIZATION
    // -------------------------------------------------------------------------
    int n = span

    string requestedSymbol = str.length(symbol) > 0
         ? symbol
         : syminfo.tickerid

    // Uniform reciprocal participation.
    float equalParticipationAlpha = 1.0 / float(n)

    // Preserve missing volume as `na` so absence of a volume series remains
    // distinguishable from an actual zero-volume observation.
    // Request volume only when required by the selected model.
    bool requiresVolume = 
         model != ParticipationModel.none
     and model != ParticipationModel.equal

    float rawCurrentVolume = na

    if requiresVolume

        rawCurrentVolume := request.security(
            requestedSymbol,
            timeframe.period,
            volume,
            gaps = barmerge.gaps_on,
            ignore_invalid_symbol = true
        )

    bool hasVolume = not na(rawCurrentVolume)

    float currentVolume = nz(
        rawCurrentVolume,
        0.0
    )

    // -------------------------------------------------------------------------
    // N-MINUTE REFERENCE VOLUME
    // -------------------------------------------------------------------------

    float previousConfirmedMinuteTotal = na

    if model == ParticipationModel.minuteVolume

        int processingSeconds = timeframe.in_seconds()

        if elapsedTime

            // ---------------------------------------------------------------------
            // ELAPSED-TIME CONTINUITY
            // N represents consecutive elapsed-minute positions.
            //
            // Absolute N-minute populations are formed from UNIX minute serials.
            // Minutes without observations retain their temporal position but
            // contribute no volume.
            //
            // The exposed denominator is always the previous completed population.
            // ---------------------------------------------------------------------

            if processingSeconds >= 60

                // -----------------------------------------------------------------
                // PROCESSING TIMEFRAME >= 1 MINUTE
                // Process all 1-minute observations from the PREVIOUS processing
                // bar, then advance the elapsed clock to the CURRENT processing-bar
                // open using a zero-volume clock event.
                // -----------------------------------------------------------------

                [ minuteVolumes,
                  minuteTimes ] = request.security_lower_tf(
                    requestedSymbol,
                    "1",
                    [
                        volume,
                        time
                    ],
                    ignore_invalid_symbol = true
                )

                array<float> previousMinuteVolumes =
                     minuteVolumes[1]

                array<int> previousMinuteTimes =
                     minuteTimes[1]

                int previousMinuteCount =
                     not na(previousMinuteVolumes)
                     and not na(previousMinuteTimes)
                     ? math.min(
                         array.size(previousMinuteVolumes),
                         array.size(previousMinuteTimes)
                     )
                     : 0

                var int lastElapsedMinuteBucket = na
                var bool elapsedMinuteStateInitialized = false

                // One additional event represents the current processing-bar
                // opening clock position.
                for i = 0 to previousMinuteCount

                    bool isMinuteObservation =
                         i < previousMinuteCount

                    int eventTime =
                         isMinuteObservation
                         ? array.get(
                             previousMinuteTimes,
                             i
                         )
                         : time

                    float eventVolume =
                         isMinuteObservation
                         ? array.get(
                             previousMinuteVolumes,
                             i
                         )
                         : 0.0

                    int minuteSerial =
                         not na(eventTime)
                         ? int(
                             math.floor(
                                 float(eventTime)
                                 / 60000.0
                             )
                         )
                         : na

                    int minuteBucket =
                         not na(minuteSerial)
                         ? int(
                             math.floor(
                                 float(minuteSerial)
                                 / float(n)
                             )
                         )
                         : na

                    bool clockAdvance =
                         not isMinuteObservation
                         and not na(minuteBucket)
                         and (
                             na(lastElapsedMinuteBucket)
                             or minuteBucket
                                 != lastElapsedMinuteBucket
                         )

                    bool sampleMinuteEvent =
                         isMinuteObservation
                         or clockAdvance

                    int minuteBucketChange =
                         sampleMinuteEvent
                         and not na(lastElapsedMinuteBucket)
                         and not na(minuteBucket)
                         ? minuteBucket
                             - lastElapsedMinuteBucket
                         : 0

                    bool minuteSettleWhen =
                         minuteBucketChange == 1

                    bool minuteResetWhen =
                         minuteBucketChange > 1

                    bool initialMinutePopulationIsPartial =
                         sampleMinuteEvent
                         and not elapsedMinuteStateInitialized
                         and not na(minuteSerial)
                         and minuteSerial % n != 0

                    float minutePopulationVolume =
                         initialMinutePopulationIsPartial
                         ? na
                         : eventVolume

                    previousConfirmedMinuteTotal := settledSumWhen(
                        minutePopulationVolume,
                        minuteSettleWhen,
                        resetWhen = minuteResetWhen,
                        sampleWhen = sampleMinuteEvent
                    )

                    if sampleMinuteEvent
                        lastElapsedMinuteBucket :=
                             minuteBucket

                        elapsedMinuteStateInitialized :=
                             true

            else

                // -----------------------------------------------------------------
                // PROCESSING TIMEFRAME < 1 MINUTE
                // One minute is a higher reference domain. Confirmed minute
                // observations and the current processing clock are handled as
                // separate events.
                // -----------------------------------------------------------------

                [ confirmedMinuteVolume,
                  confirmedMinuteTime ] = request.security(
                    requestedSymbol,
                    "1",
                    [
                        volume[1],
                        time[1]
                    ],
                    gaps = barmerge.gaps_off,
                    lookahead = barmerge.lookahead_on,
                    ignore_invalid_symbol = true
                )

                bool newConfirmedMinuteObservation =
                     not na(confirmedMinuteTime)
                     and (
                         na(confirmedMinuteTime[1])
                         or confirmedMinuteTime
                             != confirmedMinuteTime[1]
                     )

                var int lastElapsedSubMinuteBucket = na
                var bool elapsedSubMinuteStateInitialized = false

                for i = 0 to 1

                    bool isMinuteObservation =
                         i == 0
                         and newConfirmedMinuteObservation

                    int eventTime =
                         i == 0
                         ? confirmedMinuteTime
                         : time

                    float eventVolume =
                         i == 0
                         ? confirmedMinuteVolume
                         : 0.0

                    int minuteSerial =
                         not na(eventTime)
                         ? int(
                             math.floor(
                                 float(eventTime)
                                 / 60000.0
                             )
                         )
                         : na

                    int minuteBucket =
                         not na(minuteSerial)
                         ? int(
                             math.floor(
                                 float(minuteSerial)
                                 / float(n)
                             )
                         )
                         : na

                    bool clockAdvance =
                         i == 1
                         and not na(minuteBucket)
                         and (
                             na(lastElapsedSubMinuteBucket)
                             or minuteBucket
                                 != lastElapsedSubMinuteBucket
                         )

                    bool sampleMinuteEvent =
                         isMinuteObservation
                         or clockAdvance

                    int minuteBucketChange =
                         sampleMinuteEvent
                         and not na(lastElapsedSubMinuteBucket)
                         and not na(minuteBucket)
                         ? minuteBucket
                             - lastElapsedSubMinuteBucket
                         : 0

                    bool minuteSettleWhen =
                         minuteBucketChange == 1

                    bool minuteResetWhen =
                         minuteBucketChange > 1

                    bool initialMinutePopulationIsPartial =
                         sampleMinuteEvent
                         and not elapsedSubMinuteStateInitialized
                         and not na(minuteSerial)
                         and minuteSerial % n != 0

                    float minutePopulationVolume =
                         initialMinutePopulationIsPartial
                         ? na
                         : eventVolume

                    previousConfirmedMinuteTotal := settledSumWhen(
                        minutePopulationVolume,
                        minuteSettleWhen,
                        resetWhen = minuteResetWhen,
                        sampleWhen = sampleMinuteEvent
                    )

                    if sampleMinuteEvent
                        lastElapsedSubMinuteBucket :=
                             minuteBucket

                        elapsedSubMinuteStateInitialized :=
                             true

        else

            // ---------------------------------------------------------------------
            // OBSERVATION CONTINUITY
            // N counts confirmed 1-minute observations. Missing clock minutes do
            // not consume members of the N-observation population.
            // ---------------------------------------------------------------------

            if processingSeconds >= 60

                // -----------------------------------------------------------------
                // PROCESSING TIMEFRAME >= 1 MINUTE
                // -----------------------------------------------------------------

                array<float> minuteVolumes = request.security_lower_tf(
                    requestedSymbol,
                    "1",
                    volume,
                    ignore_invalid_symbol = true
                )

                array<float> previousMinuteVolumes =
                     minuteVolumes[1]

                var float minuteObservationTotal = na

                if not na(previousMinuteVolumes)

                    for minuteVolume in previousMinuteVolumes

                        minuteObservationTotal := rollingSumWhen(
                            minuteVolume,
                            true,
                            n
                        )

                previousConfirmedMinuteTotal :=
                     minuteObservationTotal

            else

                // -----------------------------------------------------------------
                // PROCESSING TIMEFRAME < 1 MINUTE
                // -----------------------------------------------------------------

                [ confirmedMinuteVolume,
                  confirmedMinuteTime ] = request.security(
                    requestedSymbol,
                    "1",
                    [
                        volume[1],
                        time[1]
                    ],
                    gaps = barmerge.gaps_off,
                    lookahead = barmerge.lookahead_on,
                    ignore_invalid_symbol = true
                )

                bool newConfirmedMinuteObservation =
                     not na(confirmedMinuteTime)
                     and (
                         na(confirmedMinuteTime[1])
                         or confirmedMinuteTime
                             != confirmedMinuteTime[1]
                     )

                previousConfirmedMinuteTotal := rollingSumWhen(
                    confirmedMinuteVolume,
                    newConfirmedMinuteObservation,
                    n
                )

    // -------------------------------------------------------------------------
    // N-HOUR REFERENCE VOLUME
    // -------------------------------------------------------------------------

    float previousConfirmedHourlyTotal = na

    if model == ParticipationModel.hourlyVolume

        if elapsedTime

            // ---------------------------------------------------------------------
            // ELAPSED-TIME CONTINUITY
            // N represents consecutive elapsed hours.
            // The exposed reference is always the previous completed population.
            // ---------------------------------------------------------------------

            int targetHourlyMs =
                 n * 60 * 60 * 1000

            if na(time_close)
                runtime.error(
                    "Elapsed-time hourly participation requires time-based observations with a known close time."
                )

            int hourlyBucketAtOpen = int(
                math.floor(
                    float(time) / float(targetHourlyMs)
                )
            )

            int hourlyBucketAtClose = int(
                math.floor(
                    float(time_close - 1) / float(targetHourlyMs)
                )
            )

            if hourlyBucketAtOpen != hourlyBucketAtClose
                runtime.error(
                    "Elapsed-time hourly participation cannot be represented exactly by the current processing timeframe."
                )

            int hourlyBucketChange = not na(hourlyBucketAtOpen[1])
                 ? hourlyBucketAtOpen - hourlyBucketAtOpen[1]
                 : 0

            bool hourlySettleWhen =
                 hourlyBucketChange == 1

            bool hourlyResetWhen =
                 hourlyBucketChange > 1

            bool initialHourlyPopulationIsPartial =
                 na(hourlyBucketAtOpen[1])
                 and time % targetHourlyMs != 0

            float hourlyPopulationVolume =
                 initialHourlyPopulationIsPartial
                 ? na
                 : rawCurrentVolume

            previousConfirmedHourlyTotal := settledSumWhen(
                hourlyPopulationVolume,
                hourlySettleWhen,
                resetWhen = hourlyResetWhen
            )

        else

            // ---------------------------------------------------------------------
            // OBSERVATION CONTINUITY
            // N represents confirmed observations of the native 1-hour reference
            // domain. Periods with no hourly observation do not consume members of
            // the N-observation population.
            //
            // Only completed hourly observations enter the rolling population.
            // ---------------------------------------------------------------------

            string hourlyTf = "60"

            if timeframe.in_seconds(hourlyTf) < timeframe.in_seconds()
                runtime.error(
                    "Hourly observation-continuity participation requires an hourly reference timeframe equal to or higher than the processing timeframe."
                )

            [ confirmedHourlyVolume,
              confirmedHourlyTime ] = request.security(
                requestedSymbol,
                hourlyTf,
                [
                    volume[1],
                    time[1]
                ],
                gaps = barmerge.gaps_off,
                lookahead = barmerge.lookahead_on,
                ignore_invalid_symbol = true
            )

            bool newConfirmedHourlyObservation =
                 not na(confirmedHourlyTime)
                 and (
                    na(confirmedHourlyTime[1])
                    or confirmedHourlyTime != confirmedHourlyTime[1]
                )

            previousConfirmedHourlyTotal := rollingSumWhen(
                confirmedHourlyVolume,
                newConfirmedHourlyObservation,
                n
            )

    // -------------------------------------------------------------------------
    // N-DAY REFERENCE VOLUME
    // -------------------------------------------------------------------------

    float previousConfirmedDailyTotal = na

    if model == ParticipationModel.dailyVolume

        if elapsedTime

            // ---------------------------------------------------------------------
            // CALENDAR CONTINUITY
            // N represents consecutive calendar trading-day positions.
            //
            // Only confirmed daily observations contribute volume, while calendar
            // days without observations still advance the population geometry.
            //
            // The exposed reference is always the previous completed population.
            // ---------------------------------------------------------------------

            string dailyTf = "1D"

            if timeframe.in_seconds(dailyTf) < timeframe.in_seconds()
                runtime.error(
                    "Daily calendar-domain participation requires a daily reference timeframe equal to or higher than the processing timeframe."
                )

            [ confirmedDailyVolume,
              confirmedDailyTradingDay ] = request.security(
                requestedSymbol,
                dailyTf,
                [
                    volume[1],
                    time_tradingday[1]
                ],
                gaps = barmerge.gaps_off,
                lookahead = barmerge.lookahead_on,
                ignore_invalid_symbol = true
            )

            bool newConfirmedDailyObservation =
                 not na(confirmedDailyTradingDay)
                 and (
                     na(confirmedDailyTradingDay[1])
                     or confirmedDailyTradingDay
                        != confirmedDailyTradingDay[1]
                )

            int dailySerial = not na(confirmedDailyTradingDay)
                 ? int(
                    math.floor(
                        float(confirmedDailyTradingDay)
                        / 86400000.0 
                    )
                )
                 : na

            int dailyBucket = not na(dailySerial)
                 ? int(
                    math.floor(
                        float(dailySerial)
                        / float(n)
                    )
                )
                 : na

            int dailyBucketChange =
                 newConfirmedDailyObservation
                 and not na(dailyBucket[1])
                 ? dailyBucket - dailyBucket[1]
                 : 0

            bool dailySettleWhen =
                 dailyBucketChange == 1

            bool dailyResetWhen =
                 dailyBucketChange > 1

            bool initialDailyPopulationIsPartial =
                 newConfirmedDailyObservation
                 and na(confirmedDailyTradingDay[1])
                 and not na(dailySerial)
                 and dailySerial % n != 0

            float dailyPopulationVolume =
                 initialDailyPopulationIsPartial
                 ? na
                 : confirmedDailyVolume

            previousConfirmedDailyTotal := settledSumWhen(
                dailyPopulationVolume,
                dailySettleWhen,
                resetWhen = dailyResetWhen,
                sampleWhen = newConfirmedDailyObservation
            )

        else

            // ---------------------------------------------------------------------
            // OBSERVATION CONTINUITY
            // N represents confirmed observations of the native 1-day reference
            // domain. Calendar periods with no daily observation do not consume
            // members of the N-observation population.
            //
            // Only completed daily observations enter the rolling population.
            // ---------------------------------------------------------------------

            string dailyTf = "1D"

            if timeframe.in_seconds(dailyTf) < timeframe.in_seconds()
                runtime.error(
                    "Daily observation-continuity participation requires a daily reference timeframe equal to or higher than the processing timeframe."
                )

            [ confirmedDailyVolume,
              confirmedDailyTime ] = request.security(
                requestedSymbol,
                dailyTf,
                [
                    volume[1],
                    time[1]
                ],
                gaps = barmerge.gaps_off,
                lookahead = barmerge.lookahead_on,
                ignore_invalid_symbol = true
            )

            bool newConfirmedDailyObservation =
                 not na(confirmedDailyTime)
                 and (
                    na(confirmedDailyTime[1])
                    or confirmedDailyTime != confirmedDailyTime[1]
                )

            previousConfirmedDailyTotal := rollingSumWhen(
                confirmedDailyVolume,
                newConfirmedDailyObservation,
                n
            )

    // -------------------------------------------------------------------------
    // N-WEEK REFERENCE VOLUME
    // -------------------------------------------------------------------------

    float previousConfirmedWeeklyTotal = na

    if model == ParticipationModel.weeklyVolume

        string weeklyTf = "1W"

        if timeframe.in_seconds(weeklyTf) < timeframe.in_seconds()
            runtime.error(
                "Weekly participation requires a weekly reference timeframe equal to or higher than the processing timeframe."
            )

        // Only confirmed weekly observations are requested.
        [ confirmedWeeklyVolume,
          confirmedWeeklyTradingDay ] = request.security(
            requestedSymbol,
            weeklyTf,
            [
                volume[1],
                time_tradingday[1]
            ],
            gaps = barmerge.gaps_off,
            lookahead = barmerge.lookahead_on,
            ignore_invalid_symbol = true
        )

        bool newConfirmedWeeklyObservation =
             not na(confirmedWeeklyTradingDay)
             and (
                 na(confirmedWeeklyTradingDay[1])
                 or confirmedWeeklyTradingDay
                    != confirmedWeeklyTradingDay[1]
            )

        if elapsedTime

            // ---------------------------------------------------------------------
            // CALENDAR CONTINUITY
            // N represents consecutive calendar-week positions.
            //
            // Calendar weeks without a confirmed weekly observation still advance
            // the population geometry but contribute no volume.
            //
            // The exposed reference is always the previous completed population.
            // ---------------------------------------------------------------------

            int tradingDaySerial = not na(confirmedWeeklyTradingDay)
                 ? int(
                    math.floor(
                        float(confirmedWeeklyTradingDay)
                        / 86400000.0
                    )
                 )
                 : na

            // UNIX day zero is Thursday, 1970-01-01.
            // Adding three days produces a Monday-aligned week serial.
            int weeklySerial = not na(tradingDaySerial)
                 ? int(
                    math.floor(
                        float(tradingDaySerial + 3)
                        / 7.0
                    )
                 )
                 : na

            int weeklyBucket = not na(weeklySerial)
                 ? int(
                    math.floor(
                        float(weeklySerial)
                        / float(n)
                    )
                 )
                 : na

            int weeklyBucketChange =
                 newConfirmedWeeklyObservation
                 and not na(weeklyBucket[1])
                 ? weeklyBucket - weeklyBucket[1]
                 : 0

            bool weeklySettleWhen =
                 weeklyBucketChange == 1

            bool weeklyResetWhen =
                 weeklyBucketChange > 1

            // Prevent the first loaded partial N-week population from being
            // exposed later as though it had been observed in full.
            bool initialWeeklyPopulationIsPartial =
                 newConfirmedWeeklyObservation
                 and na(confirmedWeeklyTradingDay[1])
                 and not na(weeklySerial)
                 and weeklySerial % n != 0

            float weeklyPopulationVolume =
                 initialWeeklyPopulationIsPartial
                 ? na
                 : confirmedWeeklyVolume

            previousConfirmedWeeklyTotal := settledSumWhen(
                 weeklyPopulationVolume,
                 weeklySettleWhen,
                 resetWhen = weeklyResetWhen,
                 sampleWhen = newConfirmedWeeklyObservation
            )

        else

            // ---------------------------------------------------------------------
            // OBSERVATION CONTINUITY
            // N represents confirmed observations of the native 1-week reference
            // domain. Calendar weeks without observations do not consume members
            // of the N-observation population.
            //
            // Because confirmedWeeklyVolume is already volume[1] from the weekly
            // reference domain, developing weekly volume never enters the window.
            // ---------------------------------------------------------------------

            previousConfirmedWeeklyTotal := rollingSumWhen(
                confirmedWeeklyVolume,
                newConfirmedWeeklyObservation,
                n
            )

    // -------------------------------------------------------------------------
    // N-MONTH REFERENCE VOLUME
    // -------------------------------------------------------------------------

    float previousConfirmedMonthlyTotal = na

    if model == ParticipationModel.monthlyVolume

        string monthlyTf = "1M"

        if timeframe.in_seconds(monthlyTf) < timeframe.in_seconds()
            runtime.error(
                "Monthly participation requires a monthly reference timeframe equal to or higher than the processing timeframe."
            )

        // Only confirmed monthly observations are requested.
        [ confirmedMonthlyVolume,
          confirmedMonthlyTime,
          confirmedMonthlyYear,
          confirmedMonthlyMonth ] = request.security(
            requestedSymbol,
            monthlyTf,
            [
                volume[1],
                time[1],
                year[1],
                month[1]
            ],
            gaps = barmerge.gaps_off,
            lookahead = barmerge.lookahead_on,
            ignore_invalid_symbol = true
        )

        bool newConfirmedMonthlyObservation =
             not na(confirmedMonthlyTime)
             and (
                 na(confirmedMonthlyTime[1])
                 or confirmedMonthlyTime
                    != confirmedMonthlyTime[1]
            )

        if elapsedTime

            // ---------------------------------------------------------------------
            // CALENDAR CONTINUITY
            // N represents consecutive calendar-month positions.
            //
            // Calendar months without a confirmed monthly observation still
            // advance the population geometry but contribute no volume.
            //
            // The exposed reference is always the previous completed population.
            // ---------------------------------------------------------------------

            int monthlySerial = 
                 not na(confirmedMonthlyYear)
                 and not na(confirmedMonthlyMonth)
                 ? confirmedMonthlyYear * 12
                   + confirmedMonthlyMonth - 1
                 : na

            int monthlyBucket = not na(monthlySerial)
                 ? int(
                    math.floor(
                        float(monthlySerial)
                        / float(n)
                    )
                 )
                 : na

            int monthlyBucketChange =
                 newConfirmedMonthlyObservation
                 and not na(monthlyBucket[1])
                 ? monthlyBucket - monthlyBucket[1]
                 : 0

            bool monthlySettleWhen =
                 monthlyBucketChange == 1

            bool monthlyResetWhen =
                 monthlyBucketChange > 1

            // Invalidate an initially loaded partial N-month population.
            bool initialMonthlyPopulationIsPartial =
                 newConfirmedMonthlyObservation
                 and na(confirmedMonthlyTime[1])
                 and not na(monthlySerial)
                 and monthlySerial % n != 0

            float monthlyPopulationVolume =
                 initialMonthlyPopulationIsPartial
                 ? na
                 : confirmedMonthlyVolume

            previousConfirmedMonthlyTotal := settledSumWhen(
                monthlyPopulationVolume,
                monthlySettleWhen,
                resetWhen = monthlyResetWhen,
                sampleWhen = newConfirmedMonthlyObservation
            )

        else

            // ---------------------------------------------------------------------
            // OBSERVATION CONTINUITY
            // N represents confirmed observations of the native 1-month reference
            // domain. Calendar months without observations do not consume members
            // of the N-observation population.
            //
            // Because confirmedMonthlyVolume is already volume[1] from the monthly
            // reference domain, developing monthly volume never enters the window.
            // ---------------------------------------------------------------------

            previousConfirmedMonthlyTotal := rollingSumWhen(
                confirmedMonthlyVolume,
                newConfirmedMonthlyObservation,
                n
            )

    // -------------------------------------------------------------------------
    // PARTICIPATION MODELS
    // -------------------------------------------------------------------------
    float outputAlpha = switch model

        // Alpha-space identity.
        ParticipationModel.none =>
            0.0

        // Every observation contributes uniformly.
        ParticipationModel.equal =>
            equalParticipationAlpha

        // Current volume relative to rolling N-observation total.
        ParticipationModel.rollingVolume =>
            float rollingVolumeTotal = rollingSum(
                rawCurrentVolume,
                n
            )

            not na(rollingVolumeTotal)
                 and rollingVolumeTotal > 0.0
                 ? currentVolume / rollingVolumeTotal
                 : na

        // Current volume relative to the settled minute-domain
        // reference population of horizon N.
        ParticipationModel.minuteVolume =>
             not hasVolume
                 ? na
                 : not na(previousConfirmedMinuteTotal)
                     and previousConfirmedMinuteTotal > 0.0
                     ? currentVolume / previousConfirmedMinuteTotal
                     : na

        // Current volume relative to the settled hourly-domain
        // reference population of horizon N.
        ParticipationModel.hourlyVolume =>
            not hasVolume
                 ? na
                 : not na(previousConfirmedHourlyTotal)
                     and previousConfirmedHourlyTotal > 0.0
                     ? currentVolume / previousConfirmedHourlyTotal
                     : na

        // Current volume relative to the settled daily-domain
        // reference population of horizon N.
        ParticipationModel.dailyVolume =>
            not hasVolume
                 ? na
                 : not na(previousConfirmedDailyTotal)
                     and previousConfirmedDailyTotal > 0.0
                     ? currentVolume / previousConfirmedDailyTotal
                     : na

        // Current volume relative to the settled weekly-domain
        // reference population of horizon N.
        ParticipationModel.weeklyVolume =>
            not hasVolume
                 ? na
                 : not na(previousConfirmedWeeklyTotal)
                     and previousConfirmedWeeklyTotal > 0.0
                     ? currentVolume / previousConfirmedWeeklyTotal
                     : na

        // Current volume relative to the settled monthly-domain
        // reference population of horizon N.
        ParticipationModel.monthlyVolume =>
             not hasVolume
                 ? na
                 : not na(previousConfirmedMonthlyTotal)
                     and previousConfirmedMonthlyTotal > 0.0
                     ? currentVolume / previousConfirmedMonthlyTotal
                     : na

        // Current traded volume relative to the latest available
        // reported EOD Open Interest.
        ParticipationModel.openInterest =>
            if not hasVolume
                na
            else
                float reportedOI = openInterestEOD(
                    requestedSymbol
                )
                not na(reportedOI) and reportedOI > 0.0
                     ? currentVolume / reportedOI
                     : na

        // Current traded shares relative to the latest available
        // reported Float Shares Outstanding.
        ParticipationModel.floatTurnover =>       
            if not hasVolume
                na
            else
                float reportedFloat = floatSharesOutstanding(
                    requestedSymbol
                )
                not na(reportedFloat) and reportedFloat > 0.0
                     ? currentVolume / reportedFloat
                     : na

        // Current traded fund units relative to the latest available
        // AUM/NAV-implied outstanding fund-unit population.
        ParticipationModel.fundTurnover =>
            if not hasVolume
                na
            else

                float reportedFundUnits = fundUnitsOutstanding(
                    requestedSymbol
                )

                not na(reportedFundUnits)
                     and reportedFundUnits > 0.0
                     ? currentVolume / reportedFundUnits
                     : na

    // -------------------------------------------------------------------------
    // OUTPUT
    // -------------------------------------------------------------------------
    float alpha = na( outputAlpha )
         ? na 
         : clamp( outputAlpha, 0.0, 1.0 )
    
    alpha


//@function
// Constructs and recursively characterizes a realized-return distribution.
//
// Realized returns are formed between consecutive chart observations using
// the selected ReturnModel.
//
// When `anchorWhen` is true, the previous population is explicitly discarded.
// A valid anchor observation contributes a zero return so the new recursive
// distribution begins at the anchor without constructing a cross-boundary
// return.
//
// If the anchor observation is unavailable, the distribution remains
// uninitialized until valid within-population return observations become
// available.
//
// Missing observations do not bridge return intervals. A realized return is
// defined only when both the current and immediately preceding chart
// observations satisfy the selected return-domain requirements.
//
//@param returnModel Selected ReturnModel.
//@param input       Current observation used to construct realized returns.
//@param alpha       Recursive distribution update coefficient.
//@param anchorWhen  Optional condition that begins a new realized-return
//                   population. Default false preserves continuous recursion.
//@returns            Tuple:
//                    [mean, sigma, tScale, absInnovationScale, df, kurtosis].
export realizedReturnDistribution(
    simple ReturnModel returnModel,
    series float input,
    series float alpha,
    series bool anchorWhen = false
) =>

    float effectiveAlpha = anchorWhen
         ? 1.0
         : alpha

    float realizedReturn = anchorWhen
         ? not na(input)
             ? 0.0
             : na
         : relativeReturn(
            returnModel,
            input,
            input[1]
        )

    heavyTailDistribution(
        realizedReturn,
        effectiveAlpha,
        resetWhen = anchorWhen
    )



//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MARKET DISPERSION MODELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━


//@function
// Estimates dimensionless market dispersion from a selected observation model.
//
// The selected DispersionModel transforms supplied market observations into
// a dimensionless relative-return or displacement stream.
//
// The resulting stream is characterized recursively using the Heavy-Tail
// distribution estimator. Market dispersion is returned as the non-negative
// root second raw moment:
//     dispersion = sqrt(mean² + sigma²)
//
// ReturnModel determines the relative-return coordinate system:
//     Arithmetic:
//         current / reference - 1
//
//     Logarithmic:
//         ln(current / reference)
//
// Mean-displacement timing:
//     Outside an anchor, the Mean Displacement model measures the current
//     `mainInput` relative to the recursive mean retained before the current
//     `meanInput` update. The current observation therefore does not alter its
//     own displacement reference.
//
//     At an explicit anchor, the previous mean state is discarded and the
//     newly initialized recursive mean is used as the reference so no state
//     from the previous population crosses the boundary.
//
// DispersionModel and ReturnModel are simple configuration values, so only
// the stateful calculations required by the selected branch are evaluated.
//
// When `anchorWhen` is true, branch-local recursive states are explicitly
// reset before processing the current observation.
//
// Valid anchor observations are processed with an effective alpha = 1,
// producing full initialization of the new anchored population.
//
// If a required anchor observation is unavailable, the affected recursive
// state remains uninitialized until a subsequent valid observation.
//
// Models requiring a previous observation exclude cross-boundary returns.
//
// The first valid return/displacement is therefore constructed entirely
// from observations belonging to the new anchored population.
//
//@param model       Selected DispersionModel.
//@param returnModel Selected ReturnModel.
//@param alpha       Recursive update coefficient.
//@param mainInput   Primary observation used for relative displacement.
//@param upperInput  Upper observation used by recursive extrema models.
//@param lowerInput  Lower observation used by recursive extrema models.
//@param meanInput   Observation used by the Recursive Mean recursion.
//@param initInput   Initialization value used by the Mean recursion.
//@param anchorWhen  Optional condition that begins a new anchored dispersion
//                    population. Default false preserves continuous recursion.
//@returns            Non-negative dimensionless market-dispersion estimate.
export marketDispersion(
    simple DispersionModel model,
    simple ReturnModel returnModel,
    series float alpha,
    series float mainInput,
    series float upperInput,
    series float lowerInput,
    series float meanInput,
    series float initInput,
    series bool  anchorWhen = false
) =>

    float effectiveAlpha = anchorWhen
         ? 1.0
         : alpha

    float dispersion = switch model

        // ---------------------------------------------------------------------
        // MEAN DISPLACEMENT
        // ---------------------------------------------------------------------
        DispersionModel.meanDisplacement =>

            var IIR1State meanState = IIR1State.new()

            if anchorWhen
                meanState.reset()

            bool validMeanObservation =
                 not na(meanInput)
                 and not na(effectiveAlpha)

            float previousMean = meanState.value

            meanState.update(
                meanInput,
                effectiveAlpha,
                initInput
            )

            float recursiveMean = validMeanObservation
                 ? meanState.value
                 : na

            float meanReference = anchorWhen
                 ? recursiveMean
                 : validMeanObservation
                     ? previousMean
                     : na

            float displacement = relativeReturn(
                returnModel,
                mainInput,
                meanReference
            )

            [ evidenceMean,
              evidenceSigma,
              _, _, _, _ ] = heavyTailDistribution(
                displacement,
                effectiveAlpha,
                resetWhen = anchorWhen
            )

            rootSecondMoment(
                evidenceMean,
                evidenceSigma
            )

        // ---------------------------------------------------------------------
        // REALIZED
        // ---------------------------------------------------------------------
        DispersionModel.realized =>

            [ evidenceMean,
              evidenceSigma,
              _, _, _, _ ] = realizedReturnDistribution(
                returnModel,
                mainInput,
                alpha,
                anchorWhen = anchorWhen
            )

            rootSecondMoment(
                evidenceMean,
                evidenceSigma
            )

        // ---------------------------------------------------------------------
        // DRAWDOWN
        // ---------------------------------------------------------------------
        DispersionModel.drawDown =>

            [ recursivePeak, _ ] = extrema(
                upperInput,
                lowerInput,
                effectiveAlpha,
                resetWhen = anchorWhen
            )

            float peakReturn = relativeReturn(
                returnModel,
                mainInput,
                recursivePeak
            )

            float drawDown = not na(peakReturn)
                 ? math.max(
                     -peakReturn,
                     0.0
                 )
                 : na

            [ evidenceMean,
              evidenceSigma,
              _, _, _, _ ] = heavyTailDistribution(
                drawDown,
                effectiveAlpha,
                resetWhen = anchorWhen
            )

            rootSecondMoment(
                evidenceMean,
                evidenceSigma
            )

        // ---------------------------------------------------------------------
        // UPTHRUST
        // ---------------------------------------------------------------------
        DispersionModel.upThrust =>

            [ _, recursiveTrough ] = extrema(
                upperInput,
                lowerInput,
                effectiveAlpha,
                resetWhen = anchorWhen
            )

            float troughReturn = relativeReturn(
                returnModel,
                mainInput,
                recursiveTrough
            )

            float upThrust = not na(troughReturn)
                 ? math.max(
                     troughReturn,
                     0.0
                 )
                 : na

            [ evidenceMean,
              evidenceSigma,
              _, _, _, _ ] = heavyTailDistribution(
                upThrust,
                effectiveAlpha,
                resetWhen = anchorWhen
            )

            rootSecondMoment(
                evidenceMean,
                evidenceSigma
            )

        // ---------------------------------------------------------------------
        // STRESS PEAKS
        // ---------------------------------------------------------------------
        DispersionModel.stressPeaks =>

            [ recursivePeak,
              recursiveTrough ] = extrema(
                upperInput,
                lowerInput,
                effectiveAlpha,
                resetWhen = anchorWhen
            )

            float peakReturn = relativeReturn(
                returnModel,
                mainInput,
                recursivePeak
            )

            float troughReturn = relativeReturn(
                returnModel,
                mainInput,
                recursiveTrough
            )

            float drawDown = not na(peakReturn)
                 ? math.max(
                     -peakReturn,
                     0.0
                 )
                 : na

            float upThrust = not na(troughReturn)
                 ? math.max(
                     troughReturn,
                     0.0
                 )
                 : na

            [ drawDownMean,
              drawDownSigma,
              _, _, _, _ ] = heavyTailDistribution(
                drawDown,
                effectiveAlpha,
                resetWhen = anchorWhen
            )

            [ upThrustMean,
              upThrustSigma,
              _, _, _, _ ] = heavyTailDistribution(
                upThrust,
                effectiveAlpha,
                resetWhen = anchorWhen
            )

            float drawDownDispersion = rootSecondMoment(
                drawDownMean,
                drawDownSigma
            )

            float upThrustDispersion = rootSecondMoment(
                upThrustMean,
                upThrustSigma
            )

            math.max(
                drawDownDispersion,
                upThrustDispersion
            )

        // ---------------------------------------------------------------------
        // STRESS AVERAGE
        // ---------------------------------------------------------------------
        DispersionModel.stressAverage =>

            [ recursivePeak,
              recursiveTrough ] = extrema(
                upperInput,
                lowerInput,
                effectiveAlpha,
                resetWhen = anchorWhen
            )

            float peakReturn = relativeReturn(
                returnModel,
                mainInput,
                recursivePeak
            )

            float troughReturn = relativeReturn(
                returnModel,
                mainInput,
                recursiveTrough
            )

            float drawDown = not na(peakReturn)
                 ? math.max(
                     -peakReturn,
                     0.0
                 )
                 : na

            float upThrust = not na(troughReturn)
                 ? math.max(
                     troughReturn,
                     0.0
                 )
                 : na

            [ drawDownMean,
              drawDownSigma,
              _, _, _, _ ] = heavyTailDistribution(
                drawDown,
                effectiveAlpha,
                resetWhen = anchorWhen
            )

            [ upThrustMean,
              upThrustSigma,
              _, _, _, _ ] = heavyTailDistribution(
                upThrust,
                effectiveAlpha,
                resetWhen = anchorWhen
            )

            float drawDownDispersion = rootSecondMoment(
                drawDownMean,
                drawDownSigma
            )

            float upThrustDispersion = rootSecondMoment(
                upThrustMean,
                upThrustSigma
            )

            (drawDownDispersion + upThrustDispersion) / 2.0

    dispersion





//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LIBRARY DEMONSTRATION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━


// -----------------------------------------------------------------------------
// MODEL CONFIGURATION
// -----------------------------------------------------------------------------

DispersionModel demoDispersionModel = input.enum(
    DispersionModel.realized,
    "Dispersion Model",
    group = "Library Demonstration"
)

ReturnModel demoReturnModel = input.enum(
    ReturnModel.logarithmic,
    "Return Model",
    group = "Library Demonstration"
)

string demoAlphaSource = input.string(
    "Anchored",
    "Alpha Source",
    options = [
        "Recursive Decay",
        "Participation",
        "Anchored",
        "Composite"
    ],
    group = "Library Demonstration"
)

DecayModel demoDecayModel = input.enum(
    DecayModel.exponential,
    "Recursive Decay Model",
    group = "Library Demonstration"
)

ParticipationModel demoParticipationModel = input.enum(
    ParticipationModel.rollingVolume,
    "Participation Model",
    group = "Library Demonstration"
)

int demoSpan = input.int(
    20,
    "Span",
    minval = 1,
    group = "Library Demonstration"
)

bool demoElapsedTime = input.bool(
    false,
    "Elapsed Time Continuity",
    group = "Library Demonstration"
)


// -----------------------------------------------------------------------------
// RECURSIVE COEFFICIENT CONSTRUCTION
// -----------------------------------------------------------------------------

// Generic N-chart-observation boundary used by the demonstration.
//
// This is not itself part of the library API. It simply provides a common
// population/settlement boundary derived from the single demo Span input.
bool demoSpanBoundary =
     bar_index % demoSpan == 0


// Fixed recursive-decay contribution.
float demoDecayAlpha = decayAlpha(
    demoDecayModel,
    demoSpan
)


// Market-participation contribution.
float demoParticipationAlpha = participationAlpha(
    demoParticipationModel,
    "",
    demoSpan,
    elapsedTime = demoElapsedTime
)


// Anchored volume-normalized contribution.
//
// The same Span boundary defines the contribution population.
float demoAnchoredAlpha = anchoredAlpha(
    volume,
    demoSpanBoundary
)


// Composite recursive contribution.
float demoCompositeAlpha = compositeAlpha(
    demoDecayAlpha,
    demoParticipationAlpha
)


// Select the coefficient family used by the price-space demonstration.
float demoAlpha = switch demoAlphaSource

    "Recursive Decay" =>
        demoDecayAlpha

    "Participation" =>
        demoParticipationAlpha

    "Anchored" =>
        demoAnchoredAlpha

    "Composite" =>
        demoCompositeAlpha

    =>
        na


// Only the explicitly anchored coefficient model owns an estimator-population
// reset in this demonstration.
//
// The same boundary is shared by coefficient normalization and estimator state
// so both describe the same recursive population.
bool demoAnchorWhen =
     demoAlphaSource == "Anchored"
     and demoSpanBoundary


// -----------------------------------------------------------------------------
// CORE RECURSIVE CALCULATIONS
// -----------------------------------------------------------------------------

// Recursive price-space equilibrium used as the center of the demonstration
// bands.
//
// The same mean inputs and anchor boundary are supplied to marketDispersion()
// so the Mean Displacement model uses an equivalent recursive mean process.
float demoMean = iir1pole(
    open,
    hlc3,
    demoAlpha,
    resetWhen = demoAnchorWhen
)


// Selected dimensionless market-dispersion model.
float demoDevelopingDispersion = marketDispersion(
    demoDispersionModel,
    demoReturnModel,
    demoAlpha,
    close,
    high,
    low,
    hlc3,
    open,
    anchorWhen = demoAnchorWhen
)


// Project the dimensionless dispersion back into price space around the
// recursively estimated equilibrium.
float demoUpper = relativeProjection(
    demoReturnModel,
    demoMean,
    demoDevelopingDispersion
)

float demoLower = relativeProjection(
    demoReturnModel,
    demoMean,
    -demoDevelopingDispersion
)


// -----------------------------------------------------------------------------
// DEMONSTRATION PLOTS
// -----------------------------------------------------------------------------

// Price-space recursive equilibrium and selected dispersion bands.
plot(
    demoUpper,
    "Upper Dispersion",
    color = color.teal,
    force_overlay = true
)

plot(
    demoMean,
    "Recursive Mean",
    color = color.orange,
    linewidth = 2,
    force_overlay = true
)

plot(
    demoLower,
    "Lower Dispersion",
    color = color.teal,
    force_overlay = true
)


// -----------------------------------------------------------------------------
// RECURSIVE COEFFICIENT COMPARISON
// -----------------------------------------------------------------------------

plot(
    demoDecayAlpha,
    "Recursive Decay Alpha",
    color = color.blue
)

plot(
    demoParticipationAlpha,
    "Participation Alpha",
    color = color.orange
)

plot(
    demoAnchoredAlpha,
    "Anchored Alpha",
    color = color.green
)

plot(
    demoCompositeAlpha,
    "Composite Alpha",
    color = color.purple,
    linewidth = 2
)

hline(
    0.0,
    "Alpha = 0",
    color = color.new(
        color.gray,
        80
    )
)

hline(
    1.0,
    "Alpha = 1",
    color = color.new(
        color.gray,
        80
    )
)

